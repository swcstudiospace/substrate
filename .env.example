# Agent Substrate environment.
# Deployed to /etc/substrate/substrate.env — root-owned, chmod 0600. Never committed.
# All Railway services are reached over the tailnet through the per-project Tailscale
# Forwarders (docs/railway-tailscale.md). No public TCP proxy, no public database domain.

# ── Event store: GreptimeDB (Railway project "Ultrathink") ────────────────────
# HTTP SQL API base via the Ultrathink forwarder.
# Read by substrate-mcp. Leave empty for local development.
# Shape: http://<ultrathink-forwarder>:4000
GREPTIME_URL=
GREPTIME_USER=
GREPTIME_PASSWORD=
GREPTIME_DB=public
# Appends are refused unless agent_events is provably in Greptime's append_mode.
# Set this to true only to knowingly accept that a colliding event may be dropped
# while the table recreate is pending — see docs/greptime-ledger.md.
SUBSTRATE_ALLOW_DEDUPLICATING_LEDGER=
# Withdraw a claim whose event did not reach the ledger — a lock the substrate
# cannot tell another agent about is worse than no lock. Unset means "on when a
# ledger is configured"; set false to accept an unrecorded claim.
SUBSTRATE_CLAIM_REQUIRE_LEDGER=

# ── Ledger: chain cache, write probe, retention (uplift-2 R5) ─────────────────
# Each session's chain tip is remembered after one read, so a steady-state emit
# costs two ledger calls (the event row and its ingest record) instead of a
# whole-ledger scan plus two. 0/false/no turns the cache off and restores one
# chain-tip read per emit. See docs/greptime-ledger.md.
SUBSTRATE_LEDGER_CHAIN_CACHE=
# Sessions whose tip is remembered at once, 1..1000000; least recently used evicted.
SUBSTRATE_LEDGER_CHAIN_CACHE_MAX=10000
# How far back in ts the one seeding read looks (days, 1..3650) before it falls
# back to reading the whole session.
SUBSTRATE_LEDGER_CHAIN_LOOKBACK_DAYS=30
# /healthz proves the ledger takes writes with one row into substrate_health at
# most this often (seconds, 0..86400). A failed probe turns /healthz 503 within
# one interval. 0 never probes, and eventsWritable is metadata-only again.
SUBSTRATE_LEDGER_WRITE_PROBE_S=60
# Retention for agent_events and event_ingest, applied at boot with
# ALTER TABLE ... SET 'ttl' only when the live value differs. Unset alters
# nothing. The policy in docs/data-planes.md is 180d; export the window first —
# docs/greptime-ledger.md, "Retention". A value that is not a Greptime duration
# (integer + unit: 180d, 4320h, 1h30m) refuses to boot.
SUBSTRATE_LEDGER_TTL=

# ── Idempotent event replay (U5-4a; docs/greptime-ledger.md § Idempotent replay) ──
# off (the default): POST /events ignores an event's idempotency_key and the
# x-substrate-replay header entirely — nothing stored, no lookup, today's
# responses. accept: a valid key (8-128 chars of A-Z a-z 0-9 . _ : -) is stored
# in the payload as the reserved key _ik, and a replay-marked request that
# carries a key takes ONE ledger read; a hit is 202 with "deduplicated": true and
# nothing written, a lookup error is 503 stored:false. enforce: every keyed
# request takes the read. Dedupe covers only the same surface, repo, graph_id,
# kind and ts. GET /healthz reports the mode as "idempotency"; a client must not
# replay against off. Enable accept on the server first, then any client spool.
# Anything else is off, with a boot warning. Roll back by setting off.
SUBSTRATE_EVENT_IDEMPOTENCY=off

# ── Ledger: anchor coverage and the verified archive (uplift-3 N6) ────────────
# `substrate ledger coverage` exits 2 when more closed hours (≥ 1 h old, last
# 7 days) hold ingest records and no anchor than this; /healthz.jobs.ledger
# reports the count either way. 0..100000. See docs/greptime-ledger.md,
# "Coverage and archive".
SUBSTRATE_LEDGER_MAX_UNCOVERED_HOURS=2
# Where `substrate ledger archive` writes when --out is omitted, and what
# infra/vps/substrate-ledger-archive.service expands into its ExecStart: an
# off-box mount, never the root disk and never the release tree — the command
# refuses /, the checkout, /opt/agent-substrate and any filesystem with fewer
# than SUBSTRATE_DEPLOY_MIN_FREE_GB gigabytes free. Unset by default: the
# command refuses by name and writes nothing. Setting SUBSTRATE_LEDGER_TTL is
# allowed only once every day that would expire has a verified manifest here.
SUBSTRATE_LEDGER_ARCHIVE_DIR=

# ── Index and coordination: TimescaleDB (Railway project "Ultrathink") ────────
# The graph index and the memory governance tables live here (docs/data-planes.md);
# the Programming Desk's queue, claim and idempotency tables are the gateway's, not
# this repo's. Read by substrate-mcp.
# Shape: postgresql://<user>:<password>@<ultrathink-forwarder>:5432/<db>
SUBSTRATE_PG_URL=
# Pool and per-connection bounds for the index client (index-store.ts). The
# defaults are what production should run; before them the client was
# `new SQL(url)` — Bun's pool of 10, no connect timeout, no statement_timeout,
# an empty application_name. Out-of-range values clamp; unparseable fall back.
# Pool size per process, 1..50.
SUBSTRATE_PG_POOL_MAX=8
# One connect may take this long, 200..60000 ms.
SUBSTRATE_PG_CONNECT_TIMEOUT_MS=2000
# statement_timeout and idle_in_transaction_session_timeout, applied as startup
# parameters on every connection. 0 leaves the server default (unbounded).
SUBSTRATE_PG_STATEMENT_TIMEOUT_MS=5000
# Idle connections are closed after this many seconds; 0 keeps them forever.
SUBSTRATE_PG_IDLE_TIMEOUT_S=300

# ── Memory lifetime (uplift-3 N4; docs/memory-governance.md § Lifetime) ───────
# What the index's serving reads do with an entry past its ttl (30d: created +
# 30 days; graph: its graph is finished or no longer indexed; permanent: never).
# report (the default) serves it tagged `expired: true`, counts it in
# substrate.memory.expired{mode=served}, and the sweep's two entries-ttl-*
# classes only count. enforce leaves it out of the brief and memory_search
# (operators may pass include_expired), counts mode=hidden, and lets the sweep
# delete it — still only under SUBSTRATE_INDEX_SWEEP=apply plus --apply. The
# retain forward refuses an expired entry in both modes. Anything else is
# report, with a boot warning. Read by the server and by the sweep job: set it
# in both environments, or the sweep keeps counting while the reads hide.
SUBSTRATE_MEMORY_EXPIRY=report

# Extra sweep printout of the two ttl classes the sweeper already counts
# (30d past 30 days, graph finished or unindexed). report (the default) lists
# entry ids and Hindsight document ids and deletes nothing. off skips that
# read. There is no enforce mode. Anything else is report, with a boot warning.
# Read by the sweep job. SUBSTRATE_INDEX_SWEEP=off still exits before the store.
SUBSTRATE_MEMORY_LIFECYCLE=report

# Hash preimage for memory.write (docs/memory-governance.md § Exactly-once).
# v1 (the default) is today's preimage. v2 adds hv and tenant inside the hash
# only: no column, no backfill, no row delete. Anything else is v1, and an
# unrecognised non-empty value warns at boot.
SUBSTRATE_HASH_VERSION=v1

# ── Runtime doctor (scripts/doctor-runtime.ts; substrate-doctor.timer) ───────
# Read-only comparison of the host (systemd, redis, df, /proc, the shared env
# by key NAME) with the policy declared under infra/vps. Exit 2 on drift.
# SUBSTRATE_DOCTOR_EMIT=1 lets `--emit` post one `warning` per drift class to
# SUBSTRATE_URL/events as the substrate surface; unset, --emit only prints a
# hint. Set it on the doctor unit's drop-in, not here: the server never needs
# it. The dedupe record (last emitted drift set per class) lives at
# SUBSTRATE_DOCTOR_STATE; the unit sets it under /var/lib/substrate.
# SUBSTRATE_DOCTOR_SWAP_PAGES_PER_S is the paging rate above which the swap
# row is drift (default 0: any page moving in the one-second sample).
SUBSTRATE_DOCTOR_EMIT=
SUBSTRATE_DOCTOR_STATE=
SUBSTRATE_DOCTOR_SWAP_PAGES_PER_S=

# Runtime doctor (uplift-5 U5-2): the highest `systemd-analyze security` exposure score
# (0-10) a substrate unit may have. Unset (default) = the doctor only REPORTS each
# unit's score and never changes its exit code; a number (e.g. 6.5, the highest staged
# ceiling) makes a unit above it `drift` (exit 2); anything else is one `warn` row.
# Read by scripts/doctor-sandbox.ts (the host-side doctor), not by the MCP server.
SUBSTRATE_EXPOSURE_MAX=

# ── Index retention sweep (index-sweep.ts; substrate-index-sweep.timer) ──────
# dry-run reports what the documented retention would remove and deletes
# nothing; apply deletes; off exits without reading the index. The CLI's
# `substrate index sweep --apply` is refused unless this is also apply — two
# keys to delete. Set on the sweep unit's drop-in, not in the server's env.
SUBSTRATE_INDEX_SWEEP=dry-run
# Days before a row is a candidate, per class (1..3650). Defaults are the
# documented retention: terminal graphs + 90 d, superseded versions 90 d,
# spent derived idempotency keys 7 d, explicit keys 30 d (exactly-once holds
# that long), decided reviews 30 d, quarantine whose content later landed 30 d.
SUBSTRATE_SWEEP_GRAPHS_DAYS=90
SUBSTRATE_SWEEP_SUPERSEDED_DAYS=90
SUBSTRATE_SWEEP_DERIVED_WRITES_DAYS=7
SUBSTRATE_SWEEP_EXPLICIT_WRITES_DAYS=30
SUBSTRATE_SWEEP_REVIEWS_DAYS=30
SUBSTRATE_SWEEP_QUARANTINE_DAYS=30
# Rows per DELETE statement, 1..5000; each statement stays inside
# SUBSTRATE_PG_STATEMENT_TIMEOUT_MS and skips rows a live writer holds.
SUBSTRATE_SWEEP_BATCH=500

# ── Memory governance ─────────────────────────────────────────────────────────
# Reviewer tokens, comma- or space-separated, 16 characters or more. The only
# thing that installs a `global` memory, records human-confirmed trust or
# releases a reviewable quarantine. Leaving this empty keeps all of those closed,
# which is the correct default: the review queue fills and nothing is forged.
# Not a surface token — a surface token says who is writing, this says a person
# checked it. See docs/memory-governance.md.
SUBSTRATE_MEMORY_REVIEW_TOKENS=
# Extra RBAC grants as a JSON array, appended to the default-deny policy:
#   [{"name":"ove-notes","surfaces":["hermes"],"scopes":["person"],"kinds":["fact"]}]
# They only ever widen the defaults. Malformed entries are dropped with a warning
# rather than failing the boot, because the defaults are the stricter policy.
SUBSTRATE_MEMORY_GRANTS=

# ── Coordination: node leases and signed handoffs ─────────────────────────────
# How long a node lease lives without a heartbeat. A dead session releases its
# node by expiry, which is the only thing a dead session reliably does. Clamped
# to 30..86400; the default is 900.
SUBSTRATE_LEASE_TTL_SECONDS=900

# Signs handoff packets, so a receiving agent can check a packet it did not see
# written. No key means handoffs are recorded unsigned rather than refused.
# Rotate by moving the live key to _PREV and giving the new one a new _ID:
# packets already in the append-only ledger keep verifying under the old id.
SUBSTRATE_HANDOFF_KEY=
SUBSTRATE_HANDOFF_KEY_ID=k1
SUBSTRATE_HANDOFF_KEY_PREV=
SUBSTRATE_HANDOFF_KEY_PREV_ID=k0

# Comma-separated tokens that may also take a node off its holder (a forced
# release or completion) — a force any peer could use would make every lease
# advisory again for anyone who chose. Each value must ALSO be one of the
# SUBSTRATE_TOKEN_* values above: operator authority is an attribute of a surface
# token, never a credential of its own, so a forced release is always
# attributable to whoever used it. The operator value is an extra
# SUBSTRATE_TOKEN_CLAUDE_CODE entry — the operator works as claude-code through
# the CLI — held only in the operator's own file, never in a hook, plugin or unit.
# A token listed here and nowhere else cannot authenticate, and the service
# says so at boot. Empty on a bare local run, where
# the machine's owner is the only caller anyway.
SUBSTRATE_OPERATOR_TOKENS=

# ── Hot cache: DragonflyDB (Railway project "Ultrathink") ─────────────────────
# Read by substrate-mcp. Cache only: brief, memory search, graph view.
# Empty leaves the cache off. A refused connection returns the same answers
# uncached. Shape: redis://<user>:<password>@<ultrathink-forwarder>:6379/0
DRAGONFLY_URL=
# Set to 0 to turn the cache off even when DRAGONFLY_URL is set.
SUBSTRATE_CACHE=
# One cache command / one connect, ms (uplift-2 R1). Sized for the loopback redis
# production points at (sub-millisecond); a wedged server costs a brief at most
# this long before it bypasses the cache. Positive integers; anything else is 250.
SUBSTRATE_CACHE_COMMAND_TIMEOUT_MS=250
SUBSTRATE_CACHE_CONNECT_TIMEOUT_MS=250
# Pattern-based cache preload (phase 47). off (default) starts no timer and composes nothing. on
# composes the brief for the most-requested repos every SUBSTRATE_CACHE_PRELOAD_S seconds and writes
# it through the cache. Needs the cache. Any other value refuses boot, naming the variable.
SUBSTRATE_CACHE_PRELOAD=off
# Repos composed per tick, 1..20 (default 3). Out of range refuses boot.
SUBSTRATE_CACHE_PRELOAD_TOP=3
# Seconds between preload ticks, 10..3600 (default 300). Out of range refuses boot.
SUBSTRATE_CACHE_PRELOAD_S=300
# SUBSTRATE_EVENT_BUS=off

# ── Data-plane endpoint policy (phase 48) ─────────────────────────────────────
# Each configured endpoint (GREPTIME_URL, SUBSTRATE_PG_URL, DRAGONFLY_URL) is
# loopback (the local end of a forwarder), proxy (its host and port listed in
# SUBSTRATE_DB_PROXY_ALLOW) or direct (anything else). warn reports a direct
# endpoint at boot and runs as before; enforce refuses boot. See docs/data-planes.md.
SUBSTRATE_DB_ENDPOINT_POLICY=warn
# Comma-separated host:port entries that the proxy class accepts. Operator-set and
# kept out of the repository. Empty lists none; a malformed entry refuses boot.
SUBSTRATE_DB_PROXY_ALLOW=

# ── Admission budgets (uplift-3 N3) ───────────────────────────────────────────
# One token bucket per authenticated surface and class (read, write,
# coordination) in the cache plane, stepped by one atomic EVAL after the bearer
# is resolved and before any handler or audit. The identity is the token's
# surface, never a body-claimed one; untokened bridge callers share `anonymous`.
# MCP batches cost one token per tools/call member and are refused whole.
# A cache that cannot answer (off, breaker open, cooldown, timeout) admits the
# caller and counts a `bypass`. Modes: `off` skips the eval (today's
# behaviour); `shadow` decides and counts substrate.admission.decisions but
# never refuses; `enforce` answers 429 with an integer Retry-After and
# {"error":"budget","class":…,"retry_after_s":…}. Anything else is shadow.
# See docs/data-planes.md, docs/observability.md and docs/grok-bot.md.
SUBSTRATE_BUDGETS=shadow
# Per surface and second; the burst is the most a bucket holds (one second of
# headroom over the rate by default). Rates may be fractional; bursts are
# positive integers; anything else keeps the default. Coordination
# (graph_claim/heartbeat/release/complete, coord_reap_leases) has its own
# bucket so a storm of reads never costs a lease.
SUBSTRATE_BUDGET_READ_RPS=20
SUBSTRATE_BUDGET_READ_BURST=40
SUBSTRATE_BUDGET_WRITE_RPS=10
SUBSTRATE_BUDGET_WRITE_BURST=20
SUBSTRATE_BUDGET_COORDINATION_RPS=30
SUBSTRATE_BUDGET_COORDINATION_BURST=60
# The bucket every accepted untokened caller shares, per class.
SUBSTRATE_BUDGET_ANONYMOUS_RPS=2
SUBSTRATE_BUDGET_ANONYMOUS_BURST=4
# Per-surface overrides, optional: SUBSTRATE_BUDGET_<SURFACE>_<CLASS>_RPS and
# _BURST with the SUBSTRATE_TOKEN_* spelling of the surface (GROK_BOT,
# SWARM_A01_ORCH, …). A half left unset is the class value above, e.g.
# SUBSTRATE_BUDGET_GROK_BOT_READ_RPS=5 keeps the read burst of 40.

# ── Memory: Hindsight (Railway project "Agent Substrate") ─────────────────────
# Read by substrate-mcp planes/hindsight.ts since Phase 26. The desk gateway
# keeps its own keys for its own paths. Shape: http://<agent-substrate-forwarder>:8888
HINDSIGHT_URL=
HINDSIGHT_API_KEY=
# bank naming: sub-<surface> for substrate surfaces, pd-<seat> for the Programming Desk
HINDSIGHT_BANK_PREFIX=sub-
# Explicit recall fan-out set beyond the caller's bank; unset reads the
# caller's bank only. Never the desk's pd-* banks.
HINDSIGHT_BANKS=
# Time bounds (uplift-2 R3), milliseconds; junk or zero falls back to the default.
# The shared abort budget of a memory_recall fan-out.
HINDSIGHT_RECALL_BUDGET_MS=4000
# The recall leg inside memory_search: shorter, so a slow plane never holds a
# search past it. A leg that misses it answers the index rows with
# degraded:true and a reason beginning `recall-timeout`.
HINDSIGHT_SEARCH_RECALL_BUDGET_MS=1500
# One retain POST.
HINDSIGHT_RETAIN_TIMEOUT_MS=8000
# HINDSIGHT_BANK (singular) is the legacy acc30a8 stub key: unread, and the
# server warns at boot when it is set. Use HINDSIGHT_BANKS above.

# ── Hindsight retain outbox (uplift-2 R3; docs/memory-governance.md) ──────────
# A retain forward that fails transiently (timeout, transport, open breaker,
# 5xx, 429) parks a locator here — never the text — and replays with backoff
# (30 s doubling to 1 h, ±20 % jitter), re-reading the entry from the index by
# id so a superseded memory is never replayed. Set the path for a 0600 JSONL
# file under the unit's StateDirectory so the queue survives a restart; unset
# keeps it in memory (retries until the process stops, then one warning per
# leftover). The unit sets /var/lib/substrate/retain-outbox.jsonl. Never the
# cache: Dragonfly is cache-only.
SUBSTRATE_RETAIN_OUTBOX_PATH=
# Most parked entries; over it the oldest is dropped with a `memory.retain.failed`
# warning (reason outbox-full).
SUBSTRATE_RETAIN_OUTBOX_MAX=10000
# Delivery attempts per entry, the live one included; the last failure emits the
# warning the forward used to emit at once. 1 restores the pre-R3 behaviour.
SUBSTRATE_RETAIN_MAX_ATTEMPTS=10
# How often due entries are replayed, ms. Also replayed after the first live
# retain that lands once the breaker had refused, and at shutdown.
SUBSTRATE_RETAIN_DRAIN_MS=30000

# ── Collector event spool (uplift-5 U5-4b; read by collectors, hooks and the CLI, not by the server) ──
# off (default): a failed event is dropped and counted, exactly as before, and no spool file is touched.
# on: a retryable failure (network error, timeout, 5xx, 503 stored:false) is parked in
# ${SUBSTRATE_STATE_DIR}/event-spool.jsonl (0600) and replayed with x-substrate-replay: 1 and the same
# idempotency key. A 4xx is never parked. Turn it on only after the server reports "idempotency": "accept"
# (or "enforce") on /healthz; the client refuses to replay against a server that does not. docs/collectors.md.
SUBSTRATE_EVENT_SPOOL=off
# Most parked lines; over it the oldest is dropped with a visible `dropped` line in refused-emits.jsonl.
SUBSTRATE_EVENT_SPOOL_MAX=5000
# Most bytes in the spool file; over it the oldest are dropped, visibly.
SUBSTRATE_EVENT_SPOOL_MAX_BYTES=8388608
# Hours a parked event is kept before it is dropped, visibly, unsent.
SUBSTRATE_EVENT_SPOOL_TTL_H=48
# Delivery attempts per event, the live one included; the last failure drops it, visibly.
SUBSTRATE_EVENT_SPOOL_MAX_ATTEMPTS=12
# refused-emits.jsonl rotates to refused-emits.jsonl.1 (one rotated file) at this size.
SUBSTRATE_REFUSED_EMITS_MAX_BYTES=1048576

# ── Documents: RAGFlow (Railway project "Agent Substrate") ────────────────────
# Read by substrate-mcp planes/ragflow.ts since Phase 25. The desk gateway
# keeps its own keys for its own paths. Shape: http://<agent-substrate-forwarder>:9380
RAGFLOW_URL=
RAGFLOW_API_KEY=
# optional; docs_ingest finds or creates the dataset named after the repo. No code
# reads this variable today (flag-registry.ts lists it as `unread`).
RAGFLOW_DATASET_ID=
# LightRAG cutover: same Railway project. LIGHTRAG_URL names the reach;
# LIGHTRAG_API_KEY is sent as the X-API-Key header on every call, never as a bearer.
# SUBSTRATE_DOCS_BACKEND pins the plane (lightrag | ragflow); unset means
# LIGHTRAG_URL presence decides. SUBSTRATE_LIGHTRAG_URL/_API_KEY override the
# unprefixed keys for the hosting layer; SUBSTRATE_LIGHTRAG_PROJECT is a report-only Railway project label and does not
# scope ingest or search.
LIGHTRAG_URL=
LIGHTRAG_API_KEY=
SUBSTRATE_DOCS_BACKEND=
SUBSTRATE_LIGHTRAG_URL=
SUBSTRATE_LIGHTRAG_API_KEY=
SUBSTRATE_LIGHTRAG_PROJECT=
# Default LightRAG query mode: naive | local | global | hybrid | mix (unset means hybrid). A LightRAG started with the
# bypass LLM (infra/railway/lightrag-llm-bypass.ts) builds no knowledge graph, so it must use naive.
# SUBSTRATE_LIGHTRAG_QUERY_MODE=naive
# Planning scrape polling (SPE-19385): ms between pollPlanningRefresh ticks
# and the roots a planning poll sweeps (comma-separated, default ".planning/").
SUBSTRATE_LIGHTRAG_POLL_MS=
SUBSTRATE_LIGHTRAG_PLANNING_ROOTS=
# Railway hosting for the LightRAG service (pin an explicit image tag or digest, never latest;
# see docs/runbooks/lightrag-storage-topology.md).
# RAILWAY_TOKEN manages the project; ids pin the target when set. SERVICE_NAME
# and PRIVATE_DOMAIN are injected by Railway at runtime — no lines for them.
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
# Comma-separated path prefixes docs_ingest may publish from; unset means
# docs/, README.md and .planning/PROJECT.md.
SUBSTRATE_DOCS_INGEST_ROOTS=
# A local checkout of swcstudiospace/agent-skills, as an absolute path (phase 42, D42-1). When it is
# set, the agent-skills merge-trigger (POST /docs/merge-trigger) ingests each skill's SKILL.md and
# references/ from it. Unset, that trigger is a noop and records no version. A relative path is
# refused with a boot warning and treated as unset. Read by substrate-mcp; docs/docs-search-ingest.md.
SUBSTRATE_AGENT_SKILLS_ROOT=
# Set to 1 on a machine that is a VM guest: docs_ingest is refused there.
SUBSTRATE_VM_GUEST=
# Where docs_ingest records live across restarts (hashes and document ids only)
# plus, since uplift-2 R6, the per-dataset version pins (file version 2; a
# version-1 file loads and is rewritten). Unset keeps them process-local. The
# unit sets /var/lib/substrate/docs-ingest.json so citations keep their commit
# pin and a repeated merge-trigger stays idempotent across restarts.
SUBSTRATE_DOCS_STATE_FILE=
# Delete a superseded document after its replacement parsed, through the
# documented DELETE /api/v1/datasets/{id}/documents (uplift-2 R6). Off keeps
# every superseded document on the plane, exactly as before. 1 turns it on; a
# failed delete is logged and recorded on the ingest result, never a refusal.
SUBSTRATE_DOCS_PRUNE_SUPERSEDED=
# Retrieval knobs sent on every docs_search retrieval (uplift-2 R6). Defaults
# are RAGFlow's own, so unset changes nothing on the wire; junk or
# out-of-range values fall back. similarity_threshold in [0, 1].
SUBSTRATE_DOCS_SIMILARITY_THRESHOLD=0.2
# vector_similarity_weight in [0, 1] — the documented legacy fallback of
# keywords_similarity_weight (0.7); the two sum to 1.
SUBSTRATE_DOCS_VECTOR_WEIGHT=0.3
# top_k, the number of chunks in the vector cosine pass (the reference marks it
# a deprecated alias of knn_top_k with the same default).
SUBSTRATE_DOCS_TOP_K=1024
# One shared deadline for every dataset's retrieval in one docs_search, ms
# (uplift-3 N5). The datasets are retrieved concurrently; a dataset that misses
# it is listed in the reply's degraded_datasets while the others still answer,
# and such a partial reply is never cached. 0 keeps only the plane client's own
# 4 s per-call timeout — the pre-N5 behaviour and the rollback.
SUBSTRATE_DOCS_SEARCH_BUDGET_MS=4000
# Tandem docs search (v1.6 phase 57c): off | on (default off). on adds the caller's Hindsight
# memory to a LightRAG answer as derived, never-cached items marked with their bank.
SUBSTRATE_DOCS_TANDEM=off
# Hindsight hits asked for and merged by a tandem search (1..10, default 5).
SUBSTRATE_DOCS_TANDEM_LIMIT=5
# The tandem Hindsight leg's own budget, ms (50..10000, default 1500); it never extends the search past it.
SUBSTRATE_DOCS_TANDEM_BUDGET_MS=1500
# LightRAG retry and breaker settings (config.ts loadRagMachineSettings): retries per call (2),
# base back-off in ms (200), consecutive failures that open the breaker (3), and the
# half-open wait in ms (30000). Unset or out-of-range values keep those defaults.
SUBSTRATE_RAG_MAX_RETRIES=
SUBSTRATE_RAG_RETRY_BASE_MS=
SUBSTRATE_RAG_BREAKER_THRESHOLD=
SUBSTRATE_RAG_HALF_OPEN_MS=
# vector_similarity_weight sent on every RAGFlow retrieval, in [0, 1]; unset is
# RAGFlow's own 0.3. SUBSTRATE_DOCS_VECTOR_WEIGHT, when set, wins for docs_search.
# A non-numeric or out-of-range value refuses to start.
# SUBSTRATE_RAGFLOW_VECTOR_WEIGHT=0.3
# Reranker model id sent as rerank_id on every RAGFlow retrieval. Unset sends no
# rerank_id at all: an unknown id on an older RAGFlow can fail the whole retrieval.
# SUBSTRATE_RAGFLOW_RERANK_ID=bge-reranker-v2-m3

# ── Control plane ─────────────────────────────────────────────────────────────
# Linear reuses the credentials already referenced by ~/.config/hermes-linear/config.yaml
LINEAR_API_KEY=
NOTION_API_KEY=
NOTION_TASK_GRAPH_DS=be3418f0-d2d8-411b-8677-fa8a95ee63be

# ── Railway control plane (Phase 45; docs/data-planes.md) ─────────────────────
# Control calls go to the Railway public API, never through the tailnet forwarders
# (D45-a). The token is the owner's: set it on the host only, never commit it.
# Empty means every railway_* tool reports unconfigured and writes refuse.
RAILWAY_API_TOKEN=
# Writes (railway_scale, railway_deploy) act only when this is exactly on AND the
# caller is an operator AND the call carries an approval_ref (D45-c). Unset: refused.
SUBSTRATE_RAILWAY_WRITES=
# Monthly ceiling in USD for the cost report; default 50, the owner's decided budget.
SUBSTRATE_RAILWAY_BUDGET_USD=
# Comma-separated Railway project ids the cost report sums over.
SUBSTRATE_RAILWAY_PROJECT_IDS=
# Operator-set unit prices in USD (cents kept). Unset means unpriced: no price is assumed.
SUBSTRATE_RAILWAY_PRICE_CPU_USD=
SUBSTRATE_RAILWAY_PRICE_MEMORY_GB_USD=
SUBSTRATE_RAILWAY_PRICE_DISK_GB_USD=
SUBSTRATE_RAILWAY_PRICE_NETWORK_TX_GB_USD=
# Bounds on a scale suggestion and on a gated write (vCPUs and GB of memory).
SUBSTRATE_RAILWAY_SCALE_MIN_VCPUS=
SUBSTRATE_RAILWAY_SCALE_MAX_VCPUS=
SUBSTRATE_RAILWAY_SCALE_MIN_MEMORY_GB=
SUBSTRATE_RAILWAY_SCALE_MAX_MEMORY_GB=
# Fraction in [0, 1] added above the p95 usage in a scale suggestion; default 0.3.
SUBSTRATE_RAILWAY_SCALE_HEADROOM=
# How far back a scale suggestion reads usage, in seconds; default 86400.
SUBSTRATE_RAILWAY_SCALE_WINDOW_SECONDS=

# ── substrate-mcp ─────────────────────────────────────────────────────────────
SUBSTRATE_URL=http://127.0.0.1:7410
SUBSTRATE_HOST=127.0.0.1
SUBSTRATE_PORT=7410
# Canonical public origin. The process stays on SUBSTRATE_HOST. TLS for this
# name is terminated by nginx; see infra/nginx/substrate.swcstudio.space.conf.
SUBSTRATE_PUBLIC_ORIGIN=https://substrate.swcstudio.space

# Unset keeps today's rule: untokened callers are accepted only when no
# SUBSTRATE_TOKEN_* is set. 1 accepts them alongside configured tokens, so a
# recognised token still names its surface while migration clients connect.
# 0 requires a bearer even when no token is set.
SUBSTRATE_ALLOW_ANONYMOUS=

# One bearer token list per surface, so events are attributable. Each variable
# holds a comma-separated list: clients of one surface at different trust get
# different values — the operator versus the claude-code hooks, the Grok Bot
# gateway versus grok-hermes-connector — and one value stays valid, so the
# change is backward compatible. A value listed under two surfaces, or a
# variable naming no surface, refuses boot with exit 78 rather than silently
# re-attributing a token. See packages/mcp-server/src/config.ts.
SUBSTRATE_TOKEN_CLAUDE_CODE=
SUBSTRATE_TOKEN_HERMES=
SUBSTRATE_TOKEN_OMP=
SUBSTRATE_TOKEN_MUSE=
SUBSTRATE_TOKEN_GROK_BUILD=
# The Grok Bot gateway and grok-hermes-connector each hold one entry here: both
# call over loopback as grok-bot.
SUBSTRATE_TOKEN_GROK_BOT=
SUBSTRATE_TOKEN_CURSOR=
SUBSTRATE_TOKEN_RIVET_AGENTOS=
# desk-gateway is not a surface (D20-01): the Programming Desk gateway
# authenticates as grok-bot above, so no SUBSTRATE_TOKEN_DESK_GATEWAY here —
# tokenConfig refuses unknown names even when empty, and a shipped example
# must boot.
SUBSTRATE_TOKEN_CODEX=
SUBSTRATE_TOKEN_OPENCODE=
SUBSTRATE_TOKEN_PI=

# The 30 Agent Swarm agents (A01..A30), one token each — server-side names, so the
# substrate can tell which agent is calling. Each swarm variable holds a single
# value: one agent, one token. A swarm client process holds exactly
# one of these values and presents it as SUBSTRATE_TOKEN (Authorization: Bearer).
# With any token set, boot lists every swarm surface that has none. See
# docs/swarm-correlation.md.
SUBSTRATE_TOKEN_SWARM_A01_ORCH=
SUBSTRATE_TOKEN_SWARM_A02_REQ=
SUBSTRATE_TOKEN_SWARM_A03_ARCH=
SUBSTRATE_TOKEN_SWARM_A04_UXD=
SUBSTRATE_TOKEN_SWARM_A05_BE=
SUBSTRATE_TOKEN_SWARM_A06_FE=
SUBSTRATE_TOKEN_SWARM_A07_DATA=
SUBSTRATE_TOKEN_SWARM_A08_QA=
SUBSTRATE_TOKEN_SWARM_A09_REV=
SUBSTRATE_TOKEN_SWARM_A10_SEC=
SUBSTRATE_TOKEN_SWARM_A11_DEVOPS=
SUBSTRATE_TOKEN_SWARM_A12_REL=
SUBSTRATE_TOKEN_SWARM_A13_OBS=
SUBSTRATE_TOKEN_SWARM_A14_MAINT=
SUBSTRATE_TOKEN_SWARM_A15_DOC=
SUBSTRATE_TOKEN_SWARM_A16_CLOUD=
SUBSTRATE_TOKEN_SWARM_A17_PLAT=
SUBSTRATE_TOKEN_SWARM_A18_SUPPLY=
SUBSTRATE_TOKEN_SWARM_A19_EVENT=
SUBSTRATE_TOKEN_SWARM_A20_FINOPS=
SUBSTRATE_TOKEN_SWARM_A21_K8S=
SUBSTRATE_TOKEN_SWARM_A22_GITOPS=
SUBSTRATE_TOKEN_SWARM_A23_MESH=
SUBSTRATE_TOKEN_SWARM_A24_KSEC=
SUBSTRATE_TOKEN_SWARM_A25_RESIL=
SUBSTRATE_TOKEN_SWARM_A26_SOL=
SUBSTRATE_TOKEN_SWARM_A27_AUDIT=
SUBSTRATE_TOKEN_SWARM_A28_CHAIN=
SUBSTRATE_TOKEN_SWARM_A29_DAPP=
SUBSTRATE_TOKEN_SWARM_A30_CUSTODY=

# The host-job surface (Phase 17): the anchor, skills sync, dispatcher and any
# other non-agent host job emit as `substrate` with payload.runtime naming the
# job. Blank here; the value lives only in /etc/substrate/substrate.env.
SUBSTRATE_TOKEN_SUBSTRATE=

# ── Skills proposals (SKILL-01; docs/skills-propose.md) ───────────────────────
# `skills_propose`, POST /skills/propose and `substrate skills propose` open a PR on
# this library. The defaults are the production library; leave them unset there.
# A different library is accepted only with a file:// remote AND an absolute gh
# path (the rehearsal harness sets all four itself); anything else boots with a
# warning and proposes nothing.
SUBSTRATE_SKILLS_REPO=
SUBSTRATE_SKILLS_REMOTE_URL=
SUBSTRATE_SKILLS_STATE=
SUBSTRATE_SKILLS_GH=
# Skills governance (uplift-5 S5; docs/skills-propose.md#approving-a-skill, docs/runbooks/skills-governance.md).
# off (default): `skills_propose` writes no registry row; `skills_approve` and `skills_list` still exist
# (approve is operator-only, needs SUBSTRATE_OPERATOR_TOKENS and a Postgres index). The skills projector
# (substrate-skills-sync.service environment) does not fetch and behaves byte-identically.
# report: the server also records a `proposed` row per proposal; the projector projects everything and posts one
# deduped `skills.sync` warning naming the unapproved library skills.
# enforce: as report; the projector links NEW skills only when approved and never unlinks anything.
# Anything else is `off` with a boot warning. One name, read by two processes (server and projector). Never switch
# to enforce before the registry holds every skill already on the library's main (bootstrap risk, same doc).
SUBSTRATE_SKILLS_GOVERNANCE=off

# ── MCP audit (SPE-4793) ──────────────────────────────────────────────────────
# The hash-chained record of what agents asked substrate-mcp to do and whether it
# was allowed. Deliberately not in Greptime: an audit has to survive an outage of
# the store it audits, and agent_events is writable by the agents being audited.
# Unset keeps the chain in memory, which ends at the next restart — local dev only.
# See docs/mcp-audit.md.
SUBSTRATE_AUDIT_PATH=/var/lib/substrate/mcp-audit.jsonl
# Roll the audit file over by size: once the next record would take the active
# file past this many bytes it is renamed to <path>.<firstSeq>-<lastSeq>.jsonl
# beside it and a fresh file starts at the same path, chained to the closed one
# (one chain, several files; verify walks them all — `bun run audit:verify`).
# Unset or 0 never rolls. 50 MB is about two months at today's 0.9 MB/day.
SUBSTRATE_AUDIT_ROLLOVER_BYTES=

# ── Observability: OTLP (SPE-4793) ────────────────────────────────────────────
# Standard OTEL_* names, because this host runs other OTLP producers too. Export is
# off when the endpoint is unset; metrics are still collected and /metrics, /slo and
# substrate evidence still work. See docs/observability.md.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Per-signal overrides, for a deployment that sends metrics and traces to different
# collectors. Each falls back to the generic endpoint above.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# k=v,k=v — a collector token belongs here, which is why this file is 0600.
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT=5000
OTEL_SERVICE_NAME=substrate-mcp
OTEL_RESOURCE_ATTRIBUTES=
SUBSTRATE_OTLP_INTERVAL_MS=30000
# Traces only. The latency histograms are recorded before the sampling decision, so
# this can never move an SLO.
SUBSTRATE_TRACE_SAMPLE_RATIO=1
SUBSTRATE_TRACE_BUFFER=2048
SUBSTRATE_INSTANCE_ID=
SUBSTRATE_ENV=

# ── SLO thresholds ────────────────────────────────────────────────────────────
# The brief threshold must be one of the histogram's bucket bounds (5, 10, 25, 50,
# 100, 200, 400, 800, 1600, 3200, 8000 ms) or the objective reports unmeasurable
# rather than interpolating an answer the buckets cannot give. A bucket bound is an
# inclusive upper edge, so the objective is checked as p95 <= this value.
SUBSTRATE_SLO_BRIEF_P95_MS=800
SUBSTRATE_SLO_EMIT_SUCCESS=0.995
# Provisional: no lease expiry exists yet (Phase 2), so there is no baseline to
# derive these from.
SUBSTRATE_SLO_LEASE_STEAL=0.005
SUBSTRATE_SLO_QUARANTINE=0.01
SUBSTRATE_SLO_MIN_SAMPLES=20
# Floor for every plane.<name>.availability objective (ok / all calls to that plane
# over the rolling hour, open-breaker refusals counted against it). Reported, never
# a status code. See docs/observability.md.
SUBSTRATE_SLO_PLANE_AVAILABILITY=0.99
# Ceiling for the docs.search.p95 row GET /slo carries beside the catalogue
# (uplift-3 N5): p95 of substrate.docs.duration, end to end, cache hit or loaded.
# Must be one of that histogram's own edges (25, 50, 100, 200, 400, 800, 1000,
# 2000, 4000, 8000 ms) or the row reports unmeasurable. Judged only after
# SUBSTRATE_SLO_MIN_SAMPLES searches; never folded into breached.
SUBSTRATE_SLO_DOCS_SEARCH_P95_MS=2000

# ── SLO history, capacity runway and notifications (uplift-3 N2) ────────────
# The SLO checkpoint keeps brief.p95, the plane windows, the burn ledger and the
# capacity ring across restarts. Unset, it lives at
# /var/lib/substrate/slo-checkpoint.json when that directory exists (the unit's
# StateDirectory) and is off on a bare local run; an absolute path overrides,
# `off` disables. Written every SUBSTRATE_SLO_CHECKPOINT_S seconds (60) and on
# shutdown; 0 writes only at shutdown. /slo.history reports the epoch and since.
SUBSTRATE_SLO_CHECKPOINT=
SUBSTRATE_SLO_CHECKPOINT_S=
# The index volume's size in bytes. /slo.capacity[0] (capacity.index.runway_days)
# is insufficient-data until this is set and /healthz has been read for 24 h.
# SUBSTRATE_SLO_RUNWAY_DAYS is the floor (14).
SUBSTRATE_INDEX_VOLUME_BYTES=
SUBSTRATE_SLO_RUNWAY_DAYS=
# SUBSTRATE_SLO_NOTIFY=1 schedules the transition notifier: every
# SUBSTRATE_SLO_NOTIFY_S (60) it judges the catalogue, planes, burn, capacity
# and breakers, and a breach / open breaker / recovery that holds for
# SUBSTRATE_SLO_NOTIFY_SUSTAIN_S (300) is one event on the ledger (surface
# substrate, payload.runtime slo), deduped through the checkpoint. Optional
# SUBSTRATE_SLO_WEBHOOK_URL is POSTed the same payload once per transition
# (5 s, no retry); it may carry a token, so it is a credential: never printed.
SUBSTRATE_SLO_NOTIFY=
SUBSTRATE_SLO_NOTIFY_S=
SUBSTRATE_SLO_NOTIFY_SUSTAIN_S=
SUBSTRATE_SLO_WEBHOOK_URL=
# Repo the Grok connector smoke (bun run smoke:grok) reads the brief for. The
# smoke is read-only and opt-in; it never writes, emits or retains.
SUBSTRATE_SMOKE_REPO=swcstudiospace/agent-substrate

# ── Plane circuit breakers (uplift-2 R2) ──────────────────────────────────────
# One breaker per data plane (greptime, index, cache, hindsight, ragflow). After
# this many consecutive transport failures, timeouts or 5xx answers the plane is
# refused in microseconds instead of waited on, until the open window passes and
# one probe succeeds. Fail-open paths degrade exactly as for an unreachable plane;
# fail-closed paths stay closed. Set SUBSTRATE_BREAKER=0 to turn every breaker
# off (calls are still measured). Values outside the ranges fall back to the
# defaults. See docs/observability.md and docs/runbooks/substrate-red.md.
SUBSTRATE_BREAKER=
# Consecutive failures that open a breaker: integer 1..100.
SUBSTRATE_BREAKER_FAILURES=5
# How long an open breaker refuses before admitting one probe, ms: 1000..600000.
SUBSTRATE_BREAKER_OPEN_MS=30000

# ── Brief fast path (uplift-2 R1) ─────────────────────────────────────────────
# POST /brief and memory_brief read their four sources (index graph, ledger recent
# actions, index open graphs, index memory) together under one deadline. A read that
# misses it is a failed read: left out, logged, the brief still answers (fail-open,
# as before), marked X-Substrate-Brief: degraded. 0 = no deadline. See
# docs/observability.md.
SUBSTRATE_BRIEF_BUDGET_MS=1200
# How far back the recent-actions ledger read looks, days. Bounds the scan so an
# uncached brief never reads a repo's whole history. Positive integer; else 30.
SUBSTRATE_BRIEF_RECENT_WINDOW_DAYS=30
# How long the last complete brief per surface and arguments is kept in the cache
# (class brief-snapshot) to serve, with a dated banner line and
# X-Substrate-Brief: snapshot, while a live source is down. Never written while a
# source is down. 0 = no snapshots written or read.
SUBSTRATE_BRIEF_SNAPSHOT_TTL_S=3600
# How long a computed GET /healthz body is served again to pollers (cachedAt and
# stale in the body say so). Each computation is one round trip per configured
# plane, and every collector polls this route. 0 = recompute on every call.
SUBSTRATE_HEALTHZ_CACHE_MS=5000

# ── Brief profile (uplift-4 S1; docs/grok-bot.md § The brief profile) ─────────
# Which rendering of the brief a caller is served. off: everyone gets the full
# text, no compact text is built. shadow (the default): everyone still gets the
# full text; the compact text is built and substrate.brief.profile_bytes_saved
# records what it would have saved. enforce: the surfaces below get a capped,
# state-carrying `compact` brief; a caller may pass profile=full (always wins) or
# profile=compact. Anything else is shadow, with a boot warning. Roll back by
# setting shadow or off and restarting; cached entries need no flush.
SUBSTRATE_BRIEF_PROFILE=shadow
# Surfaces served compact under enforce when the caller names no profile. Comma
# or whitespace separated, closed against SURFACES; unknown names are ignored
# with a boot warning, and a list with no known surface is the default.
SUBSTRATE_BRIEF_PROFILE_SURFACES=grok-bot,grok-build
# Compact limits: node lines (1..200), characters per memory line (40..4000),
# and the hard cap on the rendered text in UTF-8 bytes (512..65536; the omitted
# line counts toward it). Out-of-range values are clamped, with a boot warning.
SUBSTRATE_BRIEF_COMPACT_NODES=12
SUBSTRATE_BRIEF_COMPACT_MEMORY_CHARS=240
SUBSTRATE_BRIEF_COMPACT_BYTES=3500
# Estimated-spend ceiling for the per-surface served.tokens_est rows of GET /slo:
# tokens per rolling hour, estimated as bytes/4 of brief, recall and docs replies.
# Unset (the default) reports the rows `unconfigured` and never judges them. Not
# the model-reported burn: SUBSTRATE_BURN_TOKENS_PER_HOUR is unchanged.
SUBSTRATE_SERVED_TOKENS_PER_HOUR=

# ── Cache stale-while-revalidate (uplift-4 S4) ───────────────────────────────
# Identical concurrent cache misses already share one load (always on). This flag
# governs serving the brief's last good value, younger than the window below, while
# a fresh one is composed after a write: off never serves stale; shadow (the default)
# only counts `would_serve_stale` and serves the live brief exactly as before;
# enforce serves the last good value at once and refreshes once in the background,
# advertised by X-Substrate-Brief-Age (and `age_s` on MCP). Roll back with off.
SUBSTRATE_CACHE_SWR=shadow
# How old a last good brief may be and still be served stale, seconds (1..300, default 30).
SUBSTRATE_CACHE_SWR_WINDOW_S=30

# uplift-5 U5-3: how a graph-scoped brief reads its graph. full = four serial statements (today); lite = the index row and the nodes together (two statements, same text). Unknown values are full and named at boot.
# SUBSTRATE_BRIEF_GRAPH_READ=full

# uplift-5 U5-3: which cache generation a Hindsight retain / outbox replay bumps. legacy = the memory generation (flushes every brief and search, twice per forwarded write); narrow = a recall-only generation, and a heartbeat no longer flushes briefs. Unknown values are legacy and named at boot.
# SUBSTRATE_CACHE_BUMP_SCOPE=legacy

# uplift-5 U5-3: seconds /healthz reuses the index size report (capacity.index). 0 = measured on every computed body (today). Capped at 300; a negative or non-numeric value is 0 and named at boot.
# SUBSTRATE_HEALTHZ_INDEX_CAPACITY_MEMO_S=0

# ── Cross-session recall in the brief (uplift-4 S5) ──────────────────────────
# off (the default): no prefetcher, no timer, no cache read, no Hindsight call, the
# brief exactly as before. shadow: the prefetcher runs and every brief is counted in
# substrate.brief.recall{result} (would_include, cold, stale, disabled) while the text
# is unchanged. enforce: a bearer whose surface is the surface the brief names gets a
# `Recalled context` section built from its OWN Hindsight bank (never another's),
# read from the cache only. Needs the cache (DRAGONFLY_URL, SUBSTRATE_CACHE not 0).
# See docs/data-planes.md and docs/grok-bot.md.
SUBSTRATE_BRIEF_RECALL=off
# Seconds between prefetch ticks (30..3600, default 120).
SUBSTRATE_BRIEF_RECALL_INTERVAL_S=120
# Snapshot freshness, seconds (60..86400, default 900): up to this old is fresh,
# up to twice this is stale (counted, not shown), beyond that cold.
SUBSTRATE_BRIEF_RECALL_TTL_S=900
# Deadline of one recall inside the breaker-gated call, ms (100..10000, default 1500).
SUBSTRATE_BRIEF_RECALL_BUDGET_MS=1500
# What the brief's recall shows beyond the surface's own bank: off | graph (default off). graph adds
# up to three lines about the claimed node's graph (its own entry budget) and its own cache key.
SUBSTRATE_BRIEF_RECALL_SCOPE=off
# Read-only Hindsight bank inventory: per-configured-bank gauges, a drift report and
# an additive /healthz `hindsight` block. on | off (default off). Writes nothing.
SUBSTRATE_HINDSIGHT_INVENTORY=off
# Seconds between inventory probes (30..3600, default 60).
SUBSTRATE_HINDSIGHT_INVENTORY_INTERVAL_S=60

# ── Desktop: desktop_run (phase 30) ───────────────────────────────────────────
# Comma-separated surfaces allowed to call desktop_run, the only gate
# (an operator token grants nothing here). Unset or empty means nobody may
# call it, which is the correct default until the operator names surfaces
# after merge. A name that is not a known surface is dropped with a boot
# warning, never widened. See docs/runbooks/desktop.md.
SUBSTRATE_DESKTOP_SURFACES=
# Where desktop_run stores screenshots (<run_id>/<n>.png, dirs 0700, files
# 0600). Only an absolute path is honoured; a relative value keeps this
# default with a boot warning. Production already has it, inside the unit's
# StateDirectory.
SUBSTRATE_DESKTOP_DIR=/var/lib/substrate/desktop

# ── Hourly anchor job (phase 28, devnet only) ──────────────────────────────────
# The RPC endpoint (public devnet) and CLI default in; the keypair path and
# pubkey (non-secret) are set by the operator. No secret value ever lives here.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_ANCHOR_KEYPAIR=/etc/substrate/anchor-keypair.json
SOLANA_ANCHOR_PUBKEY=
# The verifier's bootstrap signer set: JSON text, up to 16 entries of
# {"pubkey","valid_from_ms","valid_until_ms" (a number, or null for still valid),"label"}.
# Set, it REPLACES SOLANA_ANCHOR_PUBKEY as the bootstrap, so rotating the anchor
# job to a new key does not make the old key's anchors read as a mismatch: keep
# the old key here with its valid_until_ms and add the new key from its
# valid_from_ms. Public keys only. Malformed: checkpoint_verify and memory_verify
# answer unverified. See docs/runbooks/anchor-signer-rotation.md.
# SUBSTRATE_ANCHOR_SIGNER_SET='[{"pubkey":"<OLD_PUBKEY>","valid_from_ms":0,"valid_until_ms":<ROTATION_MS>,"label":"old"},{"pubkey":"<NEW_PUBKEY>","valid_from_ms":<ROTATION_MS>,"valid_until_ms":null,"label":"new"}]'
SOLANA_CLI=/root/.local/share/solana/install/active_release/bin/solana
# Whole-verify devnet budget in ms: caps the per-hour anchor read-back loop.
SUBSTRATE_VERIFY_TIMEOUT_MS=30000

# ── Index disaster recovery (uplift-4 S2) ────────────────────────────────────
# Where `substrate index archive` writes `index-<stamp>/` snapshots. Unset: the
# command refuses by name and writes nothing. It must be a dedicated mount: the
# runner refuses a path on the root filesystem (see SUBSTRATE_INDEX_ARCHIVE_ALLOW_ROOTFS).
SUBSTRATE_INDEX_ARCHIVE_DIR=
# Hours the newest complete archive may be old before the `index.archive.age` row
# is breached (26 suits a daily timer). Unset: the row is report-only.
SUBSTRATE_INDEX_ARCHIVE_MAX_AGE_H=
# Wall-clock bound on one export, seconds (10..86400, default 900). Past it the
# transaction rolls back and nothing is left on disk.
SUBSTRATE_INDEX_ARCHIVE_MAX_SECONDS=900
# Bytes one export may write (1 MiB..1 TiB, default 1073741824).
SUBSTRATE_INDEX_ARCHIVE_MAX_BYTES=1073741824
# 1, true or yes waives ONLY the dedicated-mount gate, for a deliberate local test
# on a one-disk machine. Leave unset in production.
SUBSTRATE_INDEX_ARCHIVE_ALLOW_ROOTFS=
# Scratch Postgres URL for `substrate index restore` when --scratch is omitted
# (preferred over an argument, which `ps` shows). Read by the runner only, never
# printed; the restore refuses a URL that names the production index.
SUBSTRATE_INDEX_SCRATCH_URL=
# `apply` runs, once and idempotently at migrate, the graph_nodes storage tune
# (fillfactor 70, autovacuum scale factor 0.02). Anything else is off.
SUBSTRATE_INDEX_TUNE=

# ── VPS runtime hardening (uplift-4 S3) ──────────────────────────────────────
# Opt-in systemd watchdog: READY=1 once listening, then WATCHDOG=1 every
# WatchdogSec/3 only while the event loop is healthy and a loopback /livez answers.
# A no-op without NOTIFY_SOCKET. Set it ONLY together with the example drop-in
# infra/vps/substrate-mcp.service.d/20-watchdog.conf.example, which sets Type=notify
# (Type=notify with the flag off blocks startup). Per-unit: the drop-in sets it on
# substrate-mcp.service alone, so it stays commented here.
# SUBSTRATE_WATCHDOG=1
# Event-loop lag at or under which a heartbeat may be sent, ms (100..60000).
SUBSTRATE_WATCHDOG_LAG_MS=5000
# Deadline of the loopback /livez self-probe, ms (100..60000).
SUBSTRATE_WATCHDOG_PROBE_MS=2000
# Hard timeout of one systemd-notify child, ms (100..60000); killed at the deadline.
SUBSTRATE_WATCHDOG_NOTIFY_MS=3000
# substrate-alert@.service: longest wait for /livez before it posts its single
# `warning`, seconds (0..60; 0 posts at once). Must stay under that unit's TimeoutStartSec.
SUBSTRATE_ALERT_WAIT_S=60
# Doctor budgets (report only, nothing is deleted; 0 disables the compare):
# unique release bytes, /var/lib/substrate bytes, and journal size.
SUBSTRATE_RETAIN_RELEASE_MAX_GB=6
SUBSTRATE_STATE_MAX_GB=1
SUBSTRATE_JOURNAL_MAX_MB=400

# ── Docs freshness (uplift-4 S7) ─────────────────────────────────────────────
# Report-only staleness threshold for the `docs.freshness` row, hours (0..8760,
# default 168). 0 reports each dataset's age without judging it.
SUBSTRATE_DOCS_FRESHNESS_MAX_AGE_H=168
# Minutes an accepted merge-trigger may wait for a recorded version with its commit
# before the dataset is `lagging` (0..10080, default 15). 0 stops recording triggers
# and detecting lag. The live golden canary (SUBSTRATE_DOCS_CANARY and its manifest
# path) is configured on its own staged unit drop-in, not here: docs/docs-search-ingest.md.
SUBSTRATE_DOCS_TRIGGER_LAG_MIN=15
# Seconds between the timer passes that settle the lag warning (15..3600, default
# 60). /slo and /metrics only read the verdicts; the warning fires from this timer
# even when nobody reads them. With SUBSTRATE_DOCS_TRIGGER_LAG_MIN=0 a pass does nothing.
SUBSTRATE_DOCS_LAG_CHECK_S=60

# ── Durable metrics history (uplift-4 S6) ───────────────────────────────────
# SUBSTRATE_METRICS_HISTORY=on samples a fixed allow-list of SLO and plane series
# (brief p50/p95 per surface, emit success, plane availability and p95, cache hit
# ratio, admission decisions, docs search outcomes, capacity runway) every
# SUBSTRATE_METRICS_HISTORY_INTERVAL_S seconds into the `metric_samples` table of
# the event ledger's database, and serves them at GET /slo/history. Off by default;
# off means no timer, no table, no route payload. Also needs the event ledger (GREPTIME_URL); without it it stays off and boot says why.
SUBSTRATE_METRICS_HISTORY=
# Seconds between samples. Default 60, floor 15, ceiling 3600.
SUBSTRATE_METRICS_HISTORY_INTERVAL_S=
# Retention, put in the CREATE TABLE: whole days, 1d to 90d, default 14d. Anything
# else falls back to 14d and is named at boot. An existing table keeps the
# retention it was created with (changing it is an operator ALTER).
SUBSTRATE_METRICS_HISTORY_TTL=

# Which series the metrics history samples and serves (uplift-5 U5-6): `core` (default)
# is the 11 series above; `extended` adds the promotion evidence (cache results, brief
# profile bytes saved, brief recall and recall prefetch results, expired memory reads,
# retain outbox and index archive gauges), roughly 10-17 more rows per sampling
# interval in normal use. Opt-in because the Greptime volume size is unresolved (500 MB
# in one record, 5 GB in another). Anything else is `core` and is named at boot. See
# docs/dashboards.md.
SUBSTRATE_METRICS_HISTORY_SERIES=

# ── Names the code reads that had no line here (uplift-5 U5-7) ────────────────
# Everything below is a COMMENTED line: it documents a name and its default and
# changes nothing. packages/mcp-server/src/flag-registry.ts is the table of every
# name the code reads; docs/config-reference.md is generated from it
# (`bun run config:reference`), and flag-registry.test.ts fails when a name the
# code reads has no registry row or a `documented` row has no line in this file.
# A name set per UNIT (a drop-in, the host's env file) rather than in the shared
# env is called out in its comment.
#
# ── Client bearer (the CLI, the host and the scripts) ─────────────────────────
# A client sends ONE token. The server's SUBSTRATE_TOKEN_<SURFACE> lists above are
# server-side; a script takes the first entry of its own surface's list. Order of
# lookup: SUBSTRATE_TOKEN, then SUBSTRATE_TOKEN_FILE, then the per-surface file in
# SUBSTRATE_TOKENS_DIR (default /etc/substrate/tokens, one file per surface).
# SUBSTRATE_TOKEN=
# SUBSTRATE_TOKEN_FILE=
# SUBSTRATE_TOKENS_DIR=
#
# ── Trackers (the rehearsal points these at loopback fakes; production never sets them)
# Defaults: https://api.linear.app/graphql, https://api.notion.com, and the
# hermes-linear-connector's loopback address http://127.0.0.1:8792.
# LINEAR_API_URL=
# NOTION_API_URL=
# HERMES_LINEAR_URL=
# How long the DoD gate waits for the connector before settling via Linear state, ms.
# SUBSTRATE_DOD_GATE_TIMEOUT_MS=35000
# Steering inbox (phase 53). off (default) enables nothing and registers no steering tool.
# SUBSTRATE_PLANNING_STEERING=off
# Comma-separated human principal ids allowed to author steering directives. Empty refuses everyone.
# SUBSTRATE_PLANNING_STEERING_PRINCIPALS=
# Directives per minute per target session, 1..1000.
# SUBSTRATE_PLANNING_STEERING_RATE_PER_MIN=10
# Seconds a queued directive may wait for an acknowledgement before it expires as declined (reason timeout), 60..2592000.
# SUBSTRATE_PLANNING_STEERING_ACK_TTL_S=86400
# Seconds between expiry passes, 1..3600. Runs only while steering is on with the audit table enabled.
# SUBSTRATE_PLANNING_STEERING_EXPIRY_SWEEP_S=60
# Creates planning_steering_audit at migrate(). off (default) creates nothing; enable only after rehearsing migration 33 on a restored dump.
# SUBSTRATE_PLANNING_STEERING_AUDIT_TABLE=off
#
# ── Archives, deploy floor and the burn ceilings ──────────────────────────────
# 1, true or yes waives ONLY the dedicated-mount gate of `substrate ledger archive`
# (the index archive has its own SUBSTRATE_INDEX_ARCHIVE_ALLOW_ROOTFS above).
# SUBSTRATE_LEDGER_ARCHIVE_ALLOW_ROOTFS=
# Gigabytes that must stay free: infra/vps/deploy-release.sh refuses below it (set it
# in the shell that runs the script; its preflight and gate inherit it), the archive
# commands refuse a target filesystem below it, and the runtime doctor compares the
# release filesystem against it. 0..9999 whole gigabytes, 0 disables the gate. Default 5.
# SUBSTRATE_DEPLOY_MIN_FREE_GB=5
# Ceilings for the burn rows beside the catalogue in GET /slo: model-reported
# tokens per rolling hour, and USD per rolling hour. Unset reports the row
# `unconfigured` and never judges it (SUBSTRATE_SERVED_TOKENS_PER_HOUR above is the
# estimated-spend ceiling and is independent of these).
# SUBSTRATE_BURN_TOKENS_PER_HOUR=
# SUBSTRATE_BURN_COST_USD_PER_HOUR=
# Repo path scripts/parity-check.ts reads when it is not run from the checkout.
# SUBSTRATE_REPO=
#
# ── Docs golden canary (scripts/docs-golden.ts; set on its own unit drop-in) ──
# The live canary needs SUBSTRATE_DOCS_CANARY=1 AND a manifest the operator
# attests ({"sha256", "dataset_commit"}); it is read-only against RAGFlow. The
# state file keeps the last run for the diff. See docs/docs-search-ingest.md.
# SUBSTRATE_DOCS_CANARY=
# SUBSTRATE_DOCS_CANARY_MANIFEST=
# SUBSTRATE_DOCS_CANARY_STATE=/var/lib/substrate/docs-canary-last.json
# The CLI's docs ingest and merge-trigger call deadline, ms. Default 180000.
# SUBSTRATE_DOCS_TIMEOUT_MS=180000
#
# ── Substrate host (packages/host; its own unit env, not the server's) ────────
# SUBSTRATE_HOST_ROUTE and SUBSTRATE_TESTS_ROUTE are REQUIRED by the host: it
# refuses to start without them (values come from the 03-01 spike).
# SUBSTRATE_HOST_ROUTE=
# SUBSTRATE_TESTS_ROUTE=
# SUBSTRATE_HOST_MODEL=grok-4.6
# SUBSTRATE_HOST_PORT=7411
# Bearer token for the host task API on SUBSTRATE_HOST_PORT. Required: the host refuses to start without it. The value is never logged.
# SUBSTRATE_HOST_API_TOKEN=
# published_loopback | internal; any other value refuses to start.
# SUBSTRATE_SANDBOX_NET=published_loopback
# SUBSTRATE_SANDBOX_HOSTFN=sandbox
# Comma-separated host:port a sandbox may reach. Unset is deny-all; a malformed
# entry refuses to start naming it.
# SUBSTRATE_SANDBOX_EGRESS=
# Where the sandbox reconciliation state lives; unset is <RIVETKIT_STORAGE_PATH>/sandboxes.json.
# SUBSTRATE_SANDBOX_STATE=
# SUBSTRATE_MCP_URL=http://127.0.0.1:7410/mcp
# SUBSTRATE_ENGINE_ENDPOINT=http://127.0.0.1:6420
# Engine mode. Leave RIVET_RUN_ENGINE UNSET: the host runs against the shared engine
# above (G2 UNVERIFIED), and the literal value 1 (an owned engine, which would collide
# with the other project's container on 6420) makes it refuse to boot until
# 31-SPIKE.md records the G2 verdict (docs/runbooks/lane-a-host.md).
# RIVET_RUN_ENGINE=
# RIVET_RUN_ENGINE_HOST=127.0.0.1
# RIVETKIT_STORAGE_PATH=/var/lib/substrate/agentos
# Telegram approvals: all three or none; unset means no Telegram approvals. The
# timeout is seconds (default 900; a malformed value logs and uses the default).
# SUBSTRATE_APPROVAL_BOT_TOKEN=
# SUBSTRATE_APPROVAL_CHAT_ID=
# SUBSTRATE_APPROVAL_USER_IDS=
# SUBSTRATE_APPROVAL_TIMEOUT_S=900
# SUBSTRATE_CHECKOUT=
# SUBSTRATE_SKILLS_DIR=
# SUBSTRATE_LIBRARY_DIR=/root/agent-skills
# SUBSTRATE_SKILL_MOUNTS=nested
# SUBSTRATE_ULTRATHINK_CONFIG=/root/.config/ultrathink/config.json
# SUBSTRATE_ULTRATHINK_MCP=
# Read only when the route is anthropic_key.
# SUBSTRATE_VM_ANTHROPIC_API_KEY=
#
# ── CLI, collectors and projectors (per-hook or per-unit env) ─────────────────
# The CLI's lessons and skills call deadlines, ms. Defaults 1500 and 180000.
# SUBSTRATE_TIMEOUT_MS=1500
# SUBSTRATE_SKILLS_TIMEOUT_MS=180000
# SUBSTRATE_CLI=
# SUBSTRATE_CURSOR_ROOT=/root/.cursor
# SUBSTRATE_CURSOR_STOP=
# SUBSTRATE_TRANSCRIPTS_DIR=/var/lib/substrate/transcripts/cursor
# SUBSTRATE_COLLECTOR_STATE=
# SUBSTRATE_STATE_DIR=/var/lib/substrate
# The muse collector needs a colon-separated list of absolute roots; there is no
# inferred default and an empty value refuses.
# SUBSTRATE_MUSE_REPOS=
# SUBSTRATE_MUSE_TOKEN_FILE=/etc/substrate/substrate-collector-muse.env
# MUSE_BIN=/root/.local/bin/muse
# MUSE_PLUGIN_DIR=/var/lib/substrate/muse-plugin
# SUBSTRATE_BUN_BIN=
# SUBSTRATE_OMP_PENDING_DIR=/root/.omp/agent/substrate-pending
# GROK_SESSIONS_DIR=
# Herdr socket: HERDR_SOCKET_PATH, then HERDR_SESSION, then the default under HOME.
# HERDR_SOCKET_PATH=
# HERDR_SESSION=
#
# ── Test and smoke harness (never set in production) ──────────────────────────
# Scratch Postgres URL: without it the live index tests are skipped (docs/ci.md).
# SUBSTRATE_TEST_PG_URL=
# scripts/chaos-smoke.ts: CHAOS_REHEARSAL=1 runs it against a healthy deployment;
# the others are its window, tick and request timeout in ms.
# CHAOS_REHEARSAL=
# CHAOS_WINDOW_MS=60000
# CHAOS_TICK_MS=2000
# CHAOS_TIMEOUT_MS=10000
# scripts/uat-phase0.ts: where it reads the Claude Code MCP registration from.
# CLAUDE_CONFIG_PATH=
# ── Planning plane (phase 52, SOTA-08) ─────────────────────────────────────
# Unset: the planning plane is disabled and nothing under .planning/ is read.
# SUBSTRATE_PLANNING_ROOT=/absolute/path/to/checkout
# SUBSTRATE_PLANNING_PRESENCE_TTL_S=90
# SUBSTRATE_PLANNING_MAX_FILES=500
# SUBSTRATE_PLANNING_MAX_BYTES=262144
# SUBSTRATE_PLANNING_CHECKPOINT_DIR=/absolute/path/to/checkpoints
# SUBSTRATE_PLANNING_SCAN_INTERVAL_MS=15000
# Absolute directory where the observer keeps its publish baseline, so a change made while the process was down is published after a restart. Unset keeps it in memory.
# SUBSTRATE_PLANNING_BASELINE_DIR=/absolute/path/to/baselines
# Least milliseconds between liveness writes for a quiet checkout, 0..3600000. 0 refreshes on every scan.
# SUBSTRATE_PLANNING_LIVENESS_INTERVAL_MS=0
