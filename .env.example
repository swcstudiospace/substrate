# Agent Substrate environment.
# Deployed to /etc/substrate/substrate.env — root-owned, chmod 0600. Never committed.
# All Railway services are reached over the tailnet through the per-project Tailscale
# Forwarders (docs/railway-tailscale.md). No public TCP proxy, no public database domain.

# ── Event store: GreptimeDB (Railway project "Ultrathink") ────────────────────
# HTTP SQL API base via the Ultrathink forwarder.
# Read by substrate-mcp. Leave empty for local development.
# Shape: http://<ultrathink-forwarder>:4000
GREPTIME_URL=
GREPTIME_USER=
GREPTIME_PASSWORD=
GREPTIME_DB=public
# Appends are refused unless agent_events is provably in Greptime's append_mode.
# Set this to true only to knowingly accept that a colliding event may be dropped
# while the table recreate is pending — see docs/greptime-ledger.md.
SUBSTRATE_ALLOW_DEDUPLICATING_LEDGER=
# Withdraw a claim whose event did not reach the ledger — a lock the substrate
# cannot tell another agent about is worse than no lock. Unset means "on when a
# ledger is configured"; set false to accept an unrecorded claim.
SUBSTRATE_CLAIM_REQUIRE_LEDGER=

# ── Index and coordination: TimescaleDB (Railway project "Ultrathink") ────────
# Queue, claims, idempotency and index tables live here (docs/data-planes.md).
# Read by substrate-mcp. Shape: postgresql://<user>:<password>@<ultrathink-forwarder>:5432/<db>
SUBSTRATE_PG_URL=

# ── Memory governance ─────────────────────────────────────────────────────────
# Reviewer tokens, comma- or space-separated, 16 characters or more. The only
# thing that installs a `global` memory, records human-confirmed trust or
# releases a reviewable quarantine. Leaving this empty keeps all of those closed,
# which is the correct default: the review queue fills and nothing is forged.
# Not a surface token — a surface token says who is writing, this says a person
# checked it. See docs/memory-governance.md.
SUBSTRATE_MEMORY_REVIEW_TOKENS=
# Extra RBAC grants as a JSON array, appended to the default-deny policy:
#   [{"name":"ove-notes","surfaces":["hermes"],"scopes":["person"],"kinds":["fact"]}]
# They only ever widen the defaults. Malformed entries are dropped with a warning
# rather than failing the boot, because the defaults are the stricter policy.
SUBSTRATE_MEMORY_GRANTS=

# ── Coordination: node leases and signed handoffs ─────────────────────────────
# How long a node lease lives without a heartbeat. A dead session releases its
# node by expiry, which is the only thing a dead session reliably does. Clamped
# to 30..86400; the default is 900.
SUBSTRATE_LEASE_TTL_SECONDS=900

# Signs handoff packets, so a receiving agent can check a packet it did not see
# written. No key means handoffs are recorded unsigned rather than refused.
# Rotate by moving the live key to _PREV and giving the new one a new _ID:
# packets already in the append-only ledger keep verifying under the old id.
SUBSTRATE_HANDOFF_KEY=
SUBSTRATE_HANDOFF_KEY_ID=k1
SUBSTRATE_HANDOFF_KEY_PREV=
SUBSTRATE_HANDOFF_KEY_PREV_ID=k0

# Comma-separated tokens that may also take a node off its holder (a forced
# release or completion) — a force any peer could use would make every lease
# advisory again for anyone who chose. Each value must ALSO be one of the
# SUBSTRATE_TOKEN_* values above: operator authority is an attribute of a surface
# token, never a credential of its own, so a forced release is always
# attributable to whoever used it. The operator value is an extra
# SUBSTRATE_TOKEN_CLAUDE_CODE entry — the operator works as claude-code through
# the CLI — held only in the operator's own file, never in a hook, plugin or unit.
# A token listed here and nowhere else cannot authenticate, and the service
# says so at boot. Empty on a bare local run, where
# the machine's owner is the only caller anyway.
SUBSTRATE_OPERATOR_TOKENS=

# ── Hot cache: DragonflyDB (Railway project "Ultrathink") ─────────────────────
# Read by substrate-mcp. Cache only: brief, memory search, graph view.
# Empty leaves the cache off. A refused connection returns the same answers
# uncached. Shape: redis://<user>:<password>@<ultrathink-forwarder>:6379/0
DRAGONFLY_URL=
# Set to 0 to turn the cache off even when DRAGONFLY_URL is set.
SUBSTRATE_CACHE=

# ── Memory: Hindsight (Railway project "Agent Substrate") ─────────────────────
# Unused by substrate-mcp. The desk gateway holds HINDSIGHT_URL and
# HINDSIGHT_API_KEY and calls Hindsight itself. Listed so the names stay next
# to the plane. Shape: http://<agent-substrate-forwarder>:8888
HINDSIGHT_URL=
HINDSIGHT_API_KEY=
# bank naming: sub-<surface> for substrate surfaces, pd-<seat> for the Programming Desk
HINDSIGHT_BANK_PREFIX=sub-

# ── Documents: RAGFlow (Railway project "Agent Substrate") ────────────────────
# Read by substrate-mcp planes/ragflow.ts since Phase 25. The desk gateway
# keeps its own keys for its own paths. Shape: http://<agent-substrate-forwarder>:9380
RAGFLOW_URL=
RAGFLOW_API_KEY=
# optional; docs_ingest finds or creates the dataset named after the repo
RAGFLOW_DATASET_ID=
# Comma-separated path prefixes docs_ingest may publish from; unset means
# docs/, README.md and .planning/PROJECT.md.
SUBSTRATE_DOCS_INGEST_ROOTS=
# Set to 1 on a machine that is a VM guest: docs_ingest is refused there.
SUBSTRATE_VM_GUEST=
# Where docs_ingest records live across restarts (hashes and document ids
# only); unset keeps them process-local.
SUBSTRATE_DOCS_STATE_FILE=

# ── Control plane ─────────────────────────────────────────────────────────────
# Linear reuses the credentials already referenced by ~/.config/hermes-linear/config.yaml
LINEAR_API_KEY=
NOTION_API_KEY=
NOTION_TASK_GRAPH_DS=be3418f0-d2d8-411b-8677-fa8a95ee63be

# ── substrate-mcp ─────────────────────────────────────────────────────────────
SUBSTRATE_URL=http://127.0.0.1:7410
SUBSTRATE_HOST=127.0.0.1
SUBSTRATE_PORT=7410

# Unset keeps today's rule: untokened callers are accepted only when no
# SUBSTRATE_TOKEN_* is set. 1 accepts them alongside configured tokens, so a
# recognised token still names its surface while migration clients connect.
# 0 requires a bearer even when no token is set.
SUBSTRATE_ALLOW_ANONYMOUS=

# One bearer token list per surface, so events are attributable. Each variable
# holds a comma-separated list: clients of one surface at different trust get
# different values — the operator versus the claude-code hooks, the Grok Bot
# gateway versus grok-hermes-connector — and one value stays valid, so the
# change is backward compatible. A value listed under two surfaces, or a
# variable naming no surface, refuses boot with exit 78 rather than silently
# re-attributing a token. See packages/mcp-server/src/config.ts.
SUBSTRATE_TOKEN_CLAUDE_CODE=
SUBSTRATE_TOKEN_HERMES=
SUBSTRATE_TOKEN_OMP=
SUBSTRATE_TOKEN_MUSE=
SUBSTRATE_TOKEN_GROK_BUILD=
# The Grok Bot gateway and grok-hermes-connector each hold one entry here: both
# call over loopback as grok-bot.
SUBSTRATE_TOKEN_GROK_BOT=
SUBSTRATE_TOKEN_CURSOR=
SUBSTRATE_TOKEN_RIVET_AGENTOS=
# desk-gateway is not a surface (D20-01): the Programming Desk gateway
# authenticates as grok-bot above, so no SUBSTRATE_TOKEN_DESK_GATEWAY here —
# tokenConfig refuses unknown names even when empty, and a shipped example
# must boot.
SUBSTRATE_TOKEN_CODEX=
SUBSTRATE_TOKEN_OPENCODE=
SUBSTRATE_TOKEN_PI=

# The 15 Agent Swarm agents (A01..A15), one token each — server-side names, so the
# substrate can tell which agent is calling. Each swarm variable holds a single
# value: one agent, one token. A swarm client process holds exactly
# one of these values and presents it as SUBSTRATE_TOKEN (Authorization: Bearer).
# With any token set, boot lists every swarm surface that has none. See
# docs/swarm-correlation.md.
SUBSTRATE_TOKEN_SWARM_A01_ORCH=
SUBSTRATE_TOKEN_SWARM_A02_REQ=
SUBSTRATE_TOKEN_SWARM_A03_ARCH=
SUBSTRATE_TOKEN_SWARM_A04_UXD=
SUBSTRATE_TOKEN_SWARM_A05_BE=
SUBSTRATE_TOKEN_SWARM_A06_FE=
SUBSTRATE_TOKEN_SWARM_A07_DATA=
SUBSTRATE_TOKEN_SWARM_A08_QA=
SUBSTRATE_TOKEN_SWARM_A09_REV=
SUBSTRATE_TOKEN_SWARM_A10_SEC=
SUBSTRATE_TOKEN_SWARM_A11_DEVOPS=
SUBSTRATE_TOKEN_SWARM_A12_REL=
SUBSTRATE_TOKEN_SWARM_A13_OBS=
SUBSTRATE_TOKEN_SWARM_A14_MAINT=
SUBSTRATE_TOKEN_SWARM_A15_DOC=

# The host-job surface (Phase 17): the anchor, skills sync, dispatcher and any
# other non-agent host job emit as `substrate` with payload.runtime naming the
# job. Blank here; the value lives only in /etc/substrate/substrate.env.
SUBSTRATE_TOKEN_SUBSTRATE=

# ── Skills proposals (SKILL-01; docs/skills-propose.md) ───────────────────────
# `skills_propose`, POST /skills/propose and `substrate skills propose` open a PR on
# this library. The defaults are the production library; leave them unset there.
# A different library is accepted only with a file:// remote AND an absolute gh
# path (the rehearsal harness sets all four itself); anything else boots with a
# warning and proposes nothing.
SUBSTRATE_SKILLS_REPO=
SUBSTRATE_SKILLS_REMOTE_URL=
SUBSTRATE_SKILLS_STATE=
SUBSTRATE_SKILLS_GH=

# ── MCP audit (SPE-4793) ──────────────────────────────────────────────────────
# The hash-chained record of what agents asked substrate-mcp to do and whether it
# was allowed. Deliberately not in Greptime: an audit has to survive an outage of
# the store it audits, and agent_events is writable by the agents being audited.
# Unset keeps the chain in memory, which ends at the next restart — local dev only.
# See docs/mcp-audit.md.
SUBSTRATE_AUDIT_PATH=/var/lib/substrate/mcp-audit.jsonl

# ── Observability: OTLP (SPE-4793) ────────────────────────────────────────────
# Standard OTEL_* names, because this host runs other OTLP producers too. Export is
# off when the endpoint is unset; metrics are still collected and /metrics, /slo and
# substrate evidence still work. See docs/observability.md.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Per-signal overrides, for a deployment that sends metrics and traces to different
# collectors. Each falls back to the generic endpoint above.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# k=v,k=v — a collector token belongs here, which is why this file is 0600.
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT=5000
OTEL_SERVICE_NAME=substrate-mcp
OTEL_RESOURCE_ATTRIBUTES=
SUBSTRATE_OTLP_INTERVAL_MS=30000
# Traces only. The latency histograms are recorded before the sampling decision, so
# this can never move an SLO.
SUBSTRATE_TRACE_SAMPLE_RATIO=1
SUBSTRATE_TRACE_BUFFER=2048
SUBSTRATE_INSTANCE_ID=
SUBSTRATE_ENV=

# ── SLO thresholds ────────────────────────────────────────────────────────────
# The brief threshold must be one of the histogram's bucket bounds (5, 10, 25, 50,
# 100, 200, 400, 800, 1600, 3200, 8000 ms) or the objective reports unmeasurable
# rather than interpolating an answer the buckets cannot give. A bucket bound is an
# inclusive upper edge, so the objective is checked as p95 <= this value.
SUBSTRATE_SLO_BRIEF_P95_MS=800
SUBSTRATE_SLO_EMIT_SUCCESS=0.995
# Provisional: no lease expiry exists yet (Phase 2), so there is no baseline to
# derive these from.
SUBSTRATE_SLO_LEASE_STEAL=0.005
SUBSTRATE_SLO_QUARANTINE=0.01
SUBSTRATE_SLO_MIN_SAMPLES=20

# ── Desktop: desktop_run (phase 30) ───────────────────────────────────────────
# Comma-separated surfaces allowed to call desktop_run, the only gate
# (an operator token grants nothing here). Unset or empty means nobody may
# call it, which is the correct default until the operator names surfaces
# after merge. A name that is not a known surface is dropped with a boot
# warning, never widened. See docs/runbooks/desktop.md.
SUBSTRATE_DESKTOP_SURFACES=
# Where desktop_run stores screenshots (<run_id>/<n>.png, dirs 0700, files
# 0600). Only an absolute path is honoured; a relative value keeps this
# default with a boot warning. Production already has it, inside the unit's
# StateDirectory.
SUBSTRATE_DESKTOP_DIR=/var/lib/substrate/desktop

# ── Hourly anchor job (phase 28, devnet only) ──────────────────────────────────
# The RPC endpoint (public devnet) and CLI default in; the keypair path and
# pubkey (non-secret) are set by the operator. No secret value ever lives here.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_ANCHOR_KEYPAIR=/etc/substrate/anchor-keypair.json
SOLANA_ANCHOR_PUBKEY=
SOLANA_CLI=/root/.local/share/solana/install/active_release/bin/solana
# Whole-verify devnet budget in ms: caps the per-hour anchor read-back loop.
SUBSTRATE_VERIFY_TIMEOUT_MS=30000
