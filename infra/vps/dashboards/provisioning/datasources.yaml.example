# Grafana datasource provisioning example (generated by scripts/dashboards.ts; do not edit).
#
# Copy to Grafana's provisioning/datasources/ directory. Needs the Infinity plugin
# (yesoreyeram-infinity-datasource). The datasource reads GET <url>/slo/history, which the substrate
# serves only with SUBSTRATE_METRICS_HISTORY=on and only to a bearer.
#
# Nothing here is a value: Grafana interpolates ${SUBSTRATE_DASHBOARD_URL} (the substrate base URL)
# and ${SUBSTRATE_DASHBOARD_BEARER} (a substrate surface bearer) from ITS OWN environment. Set them in
# the environment file of the Grafana unit, never in this file or in the repository.
apiVersion: 1
datasources:
  - name: Substrate SLO history
    uid: substrate-slo-history
    type: yesoreyeram-infinity-datasource
    access: proxy
    url: ${SUBSTRATE_DASHBOARD_URL}
    isDefault: false
    editable: false
    jsonData:
      auth_method: bearerToken
      allowedHosts:
        - ${SUBSTRATE_DASHBOARD_URL}
    secureJsonData:
      bearerToken: ${SUBSTRATE_DASHBOARD_BEARER}
