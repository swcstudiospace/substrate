# substrate.slice — the cgroup every substrate-* unit runs in (uplift-2 R7).
#
# Installed to /etc/systemd/system/substrate.slice. Each unit in this directory
# carries Slice=substrate.slice, so one `systemctl status substrate.slice`
# shows the whole substrate's memory and task use, and one knob below decides
# how the kernel treats the substrate when the host is under pressure.
#
# MemoryLow=2G is protection, not a cap: when memory is reclaimed, pages of
# units in this slice are reclaimed only after the co-tenants outside it
# (the operator's other containers and checkouts on this host) have been
# reclaimed down to their own protection. Measured 2026-10-13: substrate-mcp
# 53 MB RSS, 88 MB peak; the host at 31 GiB with 12 of 15 GiB swap in use.
# 2G therefore covers the whole substrate several times over and still leaves
# the kernel free to reclaim it before anything OOM-kills.
#
# Per-unit ceilings (MemoryHigh/MemoryMax/TasksMax/CPUQuota) live in the unit
# files themselves, which are the source of truth; the slice only groups them.
[Unit]
Description=Agent Substrate units (substrate-mcp, collectors, dispatcher, host, timers' jobs)
Documentation=https://github.com/swcstudiospace/agent-substrate

[Slice]
MemoryLow=2G
