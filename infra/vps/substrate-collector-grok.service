[Unit]
Description=Agent Substrate — Grok Build session collector
Documentation=https://github.com/swcstudiospace/agent-substrate
After=substrate-mcp.service
Wants=substrate-mcp.service
# substrate-mcp may be briefly unreachable; that is not a reason to give up.
StartLimitIntervalSec=0

[Service]
Type=simple
# This collector must not load /etc/substrate/substrate.env. Its drop-in
# substrate-collector-grok.service.d/10-environment.conf points at
# /etc/substrate/collector-grok.env (URL, bearer, sessions dir — names only
# in infra/vps/README.md).
WorkingDirectory=/opt/agent-substrate/current
# Machine-specific: `command -v bun`. The binary is under /root/.local and
# the default session logs are under /root/.grok, so the unit still runs as
# root (no User=). See infra/vps/README.md.
ExecStart=/root/.local/share/reflex/bun/bin/bun packages/collectors/src/grok.ts --watch
Restart=always
RestartSec=5

# Byte offsets per session log, so a restart never replays or skips.
StateDirectory=substrate
Environment=SUBSTRATE_COLLECTOR_STATE=/var/lib/substrate/grok-offsets.json

StandardOutput=journal
StandardError=journal
SyslogIdentifier=substrate-collector-grok

# ProtectHome=false remains because bun is under /root/.local and the Grok
# session logs default to /root/.grok/sessions. WorkingDirectory is the
# release tree, not the mutable checkout.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
