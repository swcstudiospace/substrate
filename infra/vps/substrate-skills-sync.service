[Unit]
Description=Agent Substrate — skills library sync (ff-only) and projection
Documentation=https://github.com/swcstudiospace/agent-substrate
After=network-online.target substrate-mcp.service
Wants=network-online.target
# A missing code path skips the start instead of crash-looping (Phase 16 guard
# convention). Paths are machine-specific; adjust when deploying elsewhere.
ConditionPathExists=/root/.local/share/reflex/bun/bin/bun
ConditionPathExists=/opt/agent-substrate/current/packages/projector/src/skills-sync.ts
[Service]
# One tick, started by substrate-skills-sync.timer (D-04): refuse a dirty tree, a branch other
# than main or a diverged history with a warning event; otherwise fetch + merge --ff-only
# origin/main in /root/agent-skills, then the skills projector (D-05). Nothing else writes the
# checkout. git reaches the private repo through gh's stored credential (HOME=/root, hosts.yml).
Type=oneshot
EnvironmentFile=/etc/substrate/substrate.env
# Per-unit bearer carriage (Phase 20 D20-07; clients.json skills-sync row):
# names SUBSTRATE_TOKEN_SUBSTRATE by name. The value lives only on the host,
# never in this repo.
EnvironmentFile=/etc/substrate/substrate-skills-sync.env
Environment=HOME=/root
WorkingDirectory=/opt/agent-substrate/current
# Machine-specific: `command -v bun`. Adjust when deploying elsewhere.
ExecStart=/root/.local/share/reflex/bun/bin/bun packages/projector/src/skills-sync.ts

StandardOutput=journal
StandardError=journal
SyslogIdentifier=substrate-skills-sync

# Resource ceilings (uplift-2 R7): a oneshot git ff-merge plus the projector;
# substrate-mcp itself peaks at 88 MB RSS (measured 2026-10-13), so 1G is
# headroom. Lives in substrate.slice (MemoryLow=2G) so reclaim hits co-tenants
# first; the timer retries a killed run next tick.
Slice=substrate.slice
MemoryMax=1G

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
