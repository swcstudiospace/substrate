[Unit]
Description=Agent Substrate — skills library sync (ff-only) and projection
Documentation=https://github.com/swcstudiospace/agent-substrate
After=network-online.target substrate-mcp.service
Wants=network-online.target
# A missing entry skips the tick instead of crash-looping into six-figure
# NRestarts. The path is the pinned release, not the checkout:
# ConditionPathExists follows the current symlink.
StartLimitIntervalSec=0
ConditionPathExists=/opt/agent-substrate/current/packages/projector/src/skills-sync.ts

[Service]
Type=oneshot
# This tick must not load the MCP server's shared env file. Its drop-in
# substrate-skills-sync.service.d/10-environment.conf points at
# /etc/substrate/substrate-skills-sync.env (names only in infra/vps/README.md).
# One tick: refuse a dirty tree, a branch other than main or a diverged
# history with a warning event; otherwise fetch + merge --ff-only
# origin/main in /root/agent-skills, then the skills projector. Nothing else
# writes the checkout. git reaches the private repo through gh's stored
# credential (HOME=/root, hosts.yml).
WorkingDirectory=/opt/agent-substrate/current
Environment=HOME=/root
# Machine-specific: `command -v bun`. The binary on this host is under
# /root/.local, which is why the unit still runs as root (no User=) and why
# ProtectHome=false stays. The code itself is the release at WorkingDirectory.
ExecStart=/root/.local/share/reflex/bun/bin/bun packages/projector/src/skills-sync.ts

StandardOutput=journal
StandardError=journal
SyslogIdentifier=substrate-skills-sync

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
