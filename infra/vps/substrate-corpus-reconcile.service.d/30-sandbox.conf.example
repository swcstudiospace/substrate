# substrate-corpus-reconcile.service sandbox drop-in (uplift-5 U5-2). AN EXAMPLE: the `.example` suffix keeps it out of
# every `*.conf` reader (systemd, doctor-units.ts, doctor-runtime.ts), and nothing in this repo
# installs it. It is operator-installed, in its own window, after the transient test below.
# See docs/runbooks/vps-hardening.md for the class rationale and the full procedure.
#
# sandbox-class: A
# exposure-ceiling: 5.0
#
# Purpose: take the corpus reconcile unit from the shipped EXPOSED score (`systemd-analyze security`) by ending its
#   access to what it does not use. Class A: it writes only the mirror and hint spool, so the whole
#   filesystem is read-only (ProtectSystem=strict, already on the unit) and /root becomes read-only
#   (ProtectHome=read-only). The bun binary under /root/.local stays executable; it is only unwritable.
#   User= stays unset (root) because bun lives under /root/.local.
#
# Writes: /var/lib/substrate/corpus-mirrors and /var/lib/substrate/corpus-hints only
#   (StateDirectory= on the unit, two lines, not the shared /var/lib/substrate parent).
# Reads: the registered checkouts, read-only, and /opt/agent-substrate/current.
#
# Directive reasons (the shared rationale and every REJECTED directive are in the runbook):
#  - ProtectKernelModules/ProtectKernelLogs/ProtectClock/ProtectHostname: no unit loads modules, reads
#    dmesg, sets the clock or renames the host.
#  - LockPersonality/RestrictRealtime/RestrictSUIDSGID: no unit changes its ABI personality, takes a
#    realtime class or creates setuid files.
#  - SystemCallArchitectures=native: bun is a native binary of the host architecture.
#  - RestrictNamespaces=true: nothing here unshares a namespace.
#  - CapabilityBoundingSet=~...: a DENY list that keeps CAP_DAC_OVERRIDE, CAP_DAC_READ_SEARCH, CAP_FOWNER,
#    CAP_CHOWN, CAP_SETUID/GID and CAP_KILL (an empty or allow-list set was rejected, see the runbook).
#
# Test first, as a transient unit (changes no unit file; the properties are the drop-in's below). The state
# directory (when there is one) is a THROWAWAY name on purpose: never put StateDirectory=substrate in a
# transient unit, systemd would re-apply its default 0755 mode to the shared /var/lib/substrate (audit chain).
#
#   systemd-run --pipe --wait --collect \
#     -p ProtectSystem=strict \
#     -p ProtectHome=read-only \
#     -p ProtectKernelModules=true \
#     -p ProtectKernelLogs=true \
#     -p ProtectClock=true \
#     -p ProtectHostname=true \
#     -p LockPersonality=true \
#     -p RestrictRealtime=true \
#     -p RestrictSUIDSGID=true \
#     -p RestrictNamespaces=true \
#     -p SystemCallArchitectures=native \
#     -p 'CapabilityBoundingSet=~CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_SYS_RAWIO CAP_SYS_BOOT CAP_SYS_PACCT CAP_SYS_TTY_CONFIG CAP_NET_ADMIN CAP_NET_RAW CAP_MKNOD CAP_LINUX_IMMUTABLE CAP_BPF CAP_SYSLOG CAP_BLOCK_SUSPEND CAP_AUDIT_CONTROL CAP_AUDIT_READ CAP_AUDIT_WRITE CAP_LEASE CAP_MAC_ADMIN CAP_MAC_OVERRIDE' \
#     -p StateDirectory=u5-sandbox-test \
#     /bin/sh -c '/root/.local/share/reflex/bun/bin/bun --version && ! test -w /root && test -w /var/lib/u5-sandbox-test'
#
# Afterwards remove the throwaway directory:
#   rm -rf /var/lib/u5-sandbox-test
#
# Success prints the version and exits 0. Failure looks like: `Read-only file system` or `Permission
# denied` naming a path (add it to ReadWritePaths= only if the unit really writes there), exit status
# 226/NAMESPACE (a ReadWritePaths= path without a `-` prefix is missing), 218/CAPABILITIES (a denied capability is needed)
# or the process killed by SIGSYS (a non-native syscall architecture).
#
# Install (nothing below runs unless the operator runs it):
#
#   install -d -m 0755 /etc/systemd/system/substrate-corpus-reconcile.service.d
#   install -m 0644 infra/vps/substrate-corpus-reconcile.service.d/30-sandbox.conf.example \
#     /etc/systemd/system/substrate-corpus-reconcile.service.d/30-sandbox.conf
#   systemctl daemon-reload && systemctl restart substrate-corpus-reconcile.service
#   bun scripts/doctor-runtime.ts   # the exposure and sandbox rows for this unit
#
# Rollback: rm /etc/systemd/system/substrate-corpus-reconcile.service.d/30-sandbox.conf
#   then `systemctl daemon-reload` and `systemctl restart substrate-corpus-reconcile.service`. Back to the base unit.

[Service]
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
SystemCallArchitectures=native
CapabilityBoundingSet=~CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_SYS_RAWIO CAP_SYS_BOOT CAP_SYS_PACCT CAP_SYS_TTY_CONFIG CAP_NET_ADMIN CAP_NET_RAW CAP_MKNOD CAP_LINUX_IMMUTABLE CAP_BPF CAP_SYSLOG CAP_BLOCK_SUSPEND CAP_AUDIT_CONTROL CAP_AUDIT_READ CAP_AUDIT_WRITE CAP_LEASE CAP_MAC_ADMIN CAP_MAC_OVERRIDE
