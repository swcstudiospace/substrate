[Unit]
Description=Agent Substrate docs refresh (RAGFlow writer tick)
Documentation=https://github.com/swcstudiospace/agent-substrate
After=network-online.target
Wants=network-online.target
# A missed tick is repaired by the next one (drift check), so a failure must
# not trip the start limit and leave the unit dead. This key only takes effect
# in [Unit] — systemd ignores it under [Service].
StartLimitIntervalSec=0
# A missing entry point skips the start silently instead of crash-looping.
# The path is the pinned release, not the checkout: ConditionPathExists
# follows the current symlink.
ConditionPathExists=/opt/agent-substrate/current/packages/cli/src/docs-refresh.ts

[Service]
Type=oneshot
# Credentials and the watch list only; nothing secret lives in the repo.
# SUBSTRATE_TOKEN (the substrate host-job surface), SUBSTRATE_URL,
# SUBSTRATE_DOCS_WATCH (`dataset=owner/repo` pairs), SUBSTRATE_DOCS_STATE
# (default /var/lib/substrate/docs) and SUBSTRATE_AGENT_SKILLS_PATH.
# The file is root-owned and mode 0600. Enabling the timer that runs this
# unit is a live step, never done by a deploy.
EnvironmentFile=/etc/substrate/substrate.env
WorkingDirectory=/opt/agent-substrate/current
# Machine-specific: `command -v bun`. The binary on this host is under
# /root/.local, which is why the unit still runs as root (no User=) and why
# ProtectHome=false stays. The code itself is the release at WorkingDirectory.
ExecStart=/root/.local/share/reflex/bun/bin/bun packages/cli/src/docs-refresh.ts

# /var/lib/substrate, created by systemd and writable under ProtectSystem=full.
# This is where SUBSTRATE_DOCS_STATE points by default: the bare mirrors and
# the per-dataset last-refresh commits live there, not in the release tree.
StateDirectory=substrate
StateDirectoryMode=0700

StandardOutput=journal
StandardError=journal
SyslogIdentifier=substrate-docs-refresh

# It reaches the substrate on loopback and fetches public repos. Nothing else.
# ProtectHome=false is the remaining exception: ExecStart's bun lives under
# /root/.local, so ProtectHome=true would hide the interpreter.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
