[Unit]
Description=Agent Substrate MCP server (brief, memory, events, graph)
Documentation=https://github.com/swcstudiospace/agent-substrate
After=network-online.target
Wants=network-online.target
# The stores are external (Railway); a network blip must not trip the start
# limit and leave the unit dead. This key only takes effect in [Unit] —
# systemd ignores it under [Service].
StartLimitIntervalSec=0
# A missing entry point skips the start silently instead of crash-looping into
# six-figure NRestarts. The path is the pinned release, not the checkout:
# ConditionPathExists follows the current symlink.
ConditionPathExists=/opt/agent-substrate/current/packages/mcp-server/src/index.ts

[Service]
Type=simple
# Credentials only; nothing secret lives in the repo. The drop-in
# substrate-mcp.service.d/10-environment.conf is the EnvironmentFile, so a
# collector unit cannot inherit this server's file. See infra/vps/README.md.
WorkingDirectory=/opt/agent-substrate/current
# Machine-specific: `command -v bun`. The binary on this host is under
# /root/.local, which is why the unit still runs as root (no User=) and why
# ProtectHome=false stays. The code itself is the release at WorkingDirectory.
ExecStart=/root/.local/share/reflex/bun/bin/bun packages/mcp-server/src/index.ts
Restart=always
RestartSec=3

# /var/lib/substrate, created by systemd and writable under ProtectSystem=full.
# This is where SUBSTRATE_AUDIT_PATH points: the MCP audit chain is a local
# append-only file precisely so it survives an outage of the store it audits, and
# a chain that lands in a directory the unit cannot write is a chain that refuses
# every fail-closed tool. See docs/mcp-audit.md.
StateDirectory=substrate
StateDirectoryMode=0700

StandardOutput=journal
StandardError=journal
SyslogIdentifier=substrate-mcp

# It listens on loopback and talks to Postgres and Greptime. Nothing else.
# ProtectHome=false is the remaining exception: ExecStart's bun lives under
# /root/.local, so ProtectHome=true would hide the interpreter. The mutable
# checkout under /root/src/repos is not a reason for it anymore.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
