[Unit]
Description=Agent Substrate MCP server (brief, memory, events, graph)
Documentation=https://github.com/swcstudiospace/agent-substrate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Credentials only; nothing secret lives in the repo.
EnvironmentFile=/etc/substrate/substrate.env
WorkingDirectory=/root/src/repos/agent-substrate
ExecStart=/usr/local/bin/bun packages/mcp-server/src/index.ts
Restart=always
RestartSec=3
# The stores are external (Railway); a network blip must not mark the unit failed.
StartLimitIntervalSec=0

StandardOutput=journal
StandardError=journal
SyslogIdentifier=substrate-mcp

# It listens on loopback and talks to Postgres and Greptime. Nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
