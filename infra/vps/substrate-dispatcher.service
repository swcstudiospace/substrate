[Unit]
Description=Agent Substrate — dispatcher (Linear dispatch:<surface> → Hermes session)
Documentation=https://github.com/swcstudiospace/agent-substrate
After=substrate-mcp.service network-online.target
Wants=substrate-mcp.service
# Linear or substrate-mcp may be briefly unreachable; that is not a reason to give up.
# This key only takes effect in [Unit] — systemd ignores it under [Service].
StartLimitIntervalSec=0
# A missing entry point skips the start silently instead of crash-looping into
# six-figure NRestarts (September reached NRestarts=114888 on an empty code
# path). The path is the pinned release, not the checkout: ConditionPathExists
# follows the current symlink. The release is a full git archive, so the
# dispatcher sources ship with it.
ConditionPathExists=/opt/agent-substrate/current/packages/dispatcher/src/substrate_dispatcher/__main__.py

[Service]
Type=simple
# Credentials and the D-15 kill switch (SUBSTRATE_DISPATCH_DISABLED=1). The loop re-reads
# SUBSTRATE_ENV_FILE every tick, so flipping the switch needs no restart.
# Per-unit file (D24-14): names SUBSTRATE_TOKEN_SUBSTRATE, LINEAR_API_KEY and
# SUBSTRATE_DISPATCH_DISABLED — values live with the operator, never in the repo.
EnvironmentFile=/etc/substrate/substrate-dispatcher.env
Environment=HOME=/root
Environment=PYTHONPATH=/opt/agent-substrate/current/packages/dispatcher/src
Environment=SUBSTRATE_ENV_FILE=/etc/substrate/substrate-dispatcher.env
WorkingDirectory=/opt/agent-substrate/current
# System python3: httpx and pytest are already installed; no venv.
ExecStart=/usr/bin/python3 -m substrate_dispatcher
Restart=always
RestartSec=5

# The default KillMode=control-group is intentional: stopping the unit ends every dispatched
# Hermes session with it (D-15 kill switch). A restart ends them too.
# Hermes was seen ignoring SIGTERM (02-09 tracer), so the stop escalates to SIGKILL after 15 s
# instead of systemd's default 90 s.
TimeoutStopSec=15

# Lock file, prompts and session logs live under /var/lib/substrate/dispatcher.
StateDirectory=substrate

StandardOutput=journal
StandardError=journal
SyslogIdentifier=substrate-dispatcher

# Resource ceilings (uplift-2 R7). The dispatcher's cgroup holds every Hermes
# session it launches (KillMode=control-group above), so the ceiling covers
# the sessions, not just the loop; 4G is the budget for a few concurrent
# sessions on a 31 GiB host. substrate-mcp itself peaks at 88 MB RSS
# (measured 2026-10-13). Lives in substrate.slice (MemoryLow=2G) so reclaim
# hits co-tenants first. Restart=always above recovers an OOM kill.
Slice=substrate.slice
MemoryMax=4G
TasksMax=1024

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
