# Dragonfly client config for substrate (Phase 0.5)
# Copy to /etc/substrate/dragonfly.env (0600) or inject via Railway env
# Private URL only. Never public.
DRAGONFLY_URL=redis://dragonfly.railway.internal:6379
DRAGONFLY_TLS=0
# For snapshot/outbox/lease/policy-cache use only.
# See docs/governance.md ADR-0002
