{
  "name": "agent-substrate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Four-plane substrate (runtime, memory, skills, ledger) shared by every agent on the VPS, keyed by Graph ID",
  "workspaces": [
    "packages/mcp-server",
    "packages/cli",
    "packages/host",
    "packages/collectors",
    "packages/projector",
    "packages/ledger",
    "packages/observability",
    "packages/audit",
    "packages/evidence"
  ],
  "scripts": {
    "test": "bun test",
    "test:py": "python3 -m pytest packages/miner/tests",
    "mcp": "bun packages/mcp-server/src/index.ts",
    "substrate": "bun packages/cli/src/index.ts",
    "smoke:greptime": "bun scripts/greptime-smoke.ts",
    "smoke:chaos": "bun scripts/chaos-smoke.ts",
    "smoke:vocabulary": "bun scripts/vocabulary-smoke.ts",
    "smoke:skills-propose": "bun scripts/skills-propose-smoke.ts",
    "smoke:desktop": "bun scripts/desktop-smoke.ts",
    "smoke:mirror": "bun scripts/mirror-smoke.ts",
    "check:phase-close": "bun scripts/phase-close-check.ts",
    "verify": "bun scripts/verify.ts",
    "parity:check": "bun scripts/parity-check.ts",
    "rehearsal": "bun scripts/rehearsal.ts",
    "identity:check": "bun scripts/identity-check.ts",
    "uat:phase0": "bun scripts/uat-phase0.ts",
    "collectors:status": "bun packages/collectors/src/status.ts",
    "proof:laneb": "bun scripts/laneb-proof.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
