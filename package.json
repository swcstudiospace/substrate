{
  "name": "agent-substrate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "description": "Four-plane substrate (runtime, memory, skills, ledger) shared by every agent on the VPS, keyed by Graph ID",
  "workspaces": [
    "packages/mcp-server",
    "packages/cli",
    "packages/host",
    "packages/collectors",
    "packages/projector",
    "packages/ledger",
    "packages/observability",
    "packages/audit",
    "packages/evidence",
    "packages/worktree-snapshot",
    "packages/fleet"
  ],
  "scripts": {
    "test": "bun test",
    "test:py": "python3 -m pytest packages/miner/tests packages/dispatcher/tests",
    "mcp": "bun packages/mcp-server/src/index.ts",
    "substrate": "bun packages/cli/src/index.ts",
    "ledger:coverage": "bun packages/cli/src/index.ts ledger coverage",
    "ledger:verify-archive": "bun packages/cli/src/index.ts ledger verify-archive",
    "smoke:greptime": "bun scripts/greptime-smoke.ts",
    "smoke:chaos": "bun scripts/chaos-smoke.ts",
    "smoke:grok": "bun scripts/grok-connector-smoke.ts",
    "docs:golden": "bun scripts/docs-golden.ts",
    "dashboards:build": "bun scripts/dashboards.ts",
    "smoke:skills-propose": "bun scripts/skills-propose-smoke.ts",
    "smoke:skills-sync": "bun scripts/skills-sync-smoke.ts",
    "smoke:desktop": "bun scripts/desktop-smoke.ts",
    "smoke:mirror": "bun scripts/mirror-smoke.ts",
    "smoke:dispatcher": "bun scripts/dispatcher-smoke.ts",
    "smoke:host": "bun scripts/host-smoke.ts",
    "check:phase-close": "bun scripts/phase-close-check.ts",
    "verify": "bun scripts/verify.ts",
    "audit:verify": "bun scripts/audit-verify.ts",
    "parity:check": "bun scripts/parity-check.ts",
    "doctor:runtime": "bun scripts/doctor-runtime.ts",
    "advisor:promote": "bun scripts/promote-advisor.ts",
    "config:reference": "bun scripts/config-reference.ts",
    "deploy:preflight": "bun scripts/deploy-preflight.ts",
    "rehearsal": "bun scripts/rehearsal.ts",
    "gate:boot": "bun scripts/release-gate.ts",
    "identity:check": "bun scripts/identity-check.ts",
    "uat:phase0": "bun scripts/uat-phase0.ts",
    "collectors:status": "bun packages/collectors/src/status.ts",
    "proof:laneb": "bun scripts/laneb-proof.ts",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
