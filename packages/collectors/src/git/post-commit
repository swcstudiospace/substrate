#!/usr/bin/env bash
# Agent Substrate — git post-commit collector.
#
# Emits a `commit` event for every commit in this repo, attributed to the
# surface that made it. Installed by `bun packages/collectors/src/install-git-hook.ts`.
#
# post-commit runs after the commit is already written, so nothing here can
# abort it — but this still exits 0 unconditionally and backgrounds the call so
# a slow or dead substrate never delays the user's shell.
#
# A non-ok response prints one line (status and the server's error, never the
# commit payload) and the commit still succeeds. On a terminal that line is on
# the terminal. With no controlling terminal it is appended to
# SUBSTRATE_HOOK_LOG, or $XDG_STATE_HOME/substrate/post-commit.log, or
# ~/.local/state/substrate/post-commit.log. SUBSTRATE_HOOK_WAIT=1 waits for the
# post and prints the line on this process's stderr; git does not set it.

set -u

command -v bun >/dev/null 2>&1 || exit 0
command -v git >/dev/null 2>&1 || exit 0

sha="$(git rev-parse --short HEAD 2>/dev/null)" || exit 0
subject="$(git log -1 --pretty=%s 2>/dev/null || true)"
files="$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null | head -20 | jq -R . | jq -s -c . 2>/dev/null || echo '[]')"
origin="$(git remote get-url origin 2>/dev/null || true)"
repo=""
if [ -n "$origin" ]; then
	# Strip a trailing .git before the slug match. A greedy `[^/]*` would
	# otherwise keep it (`git@host:owner/repo.git` → `owner/repo.git`) and
	# briefs that query `owner/repo` would miss the commit.
	repo="$(printf '%s\n' "$origin" | sed -E 's#\.git$##' | sed -nE 's#^.*[:/]([^/:]+/[^/]+)$#\1#p')"
fi
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"

# SUBSTRATE_SURFACE lets a wrapper attribute the commit; a bare terminal commit
# is the human's, not an agent's.
surface="${SUBSTRATE_SURFACE:-cursor}"
actor="${SUBSTRATE_ACTOR:-human}"
#
# Bearer for the event surface in D20-04 order: the environment value, else
# the first line of the file named by the token-file variable, else the first
# line of the per-surface file in the tokens dir. Anything unreadable means
# no bearer (fail-open), exactly as before; the value is never printed.
first_line() {
	[ -f "$1" ] && [ -r "$1" ] || return 0
	if [ "$(wc -c < "$1" 2>/dev/null || echo 999999)" -gt 4096 ]; then return 0; fi
	IFS= read -r line < "$1" 2>/dev/null || return 0
	printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' 2>/dev/null
}
# Joined to a path below, so anything but lower-alnum-dash never reads.
case "$surface" in
	[a-z0-9]*)
		case "$surface" in *[!a-z0-9-]* ) safe_surface="";; *) safe_surface="$surface";; esac
		;;
	*) safe_surface="";;
esac
bearer="${SUBSTRATE_TOKEN:-}"
if [ -z "$bearer" ] && [ -n "${SUBSTRATE_TOKEN_FILE:-}" ]; then
	bearer="$(first_line "$SUBSTRATE_TOKEN_FILE")"
fi
if [ -z "$bearer" ] && [ -n "$safe_surface" ]; then
	tokens_dir="${SUBSTRATE_TOKENS_DIR:-}"
	[ -n "$tokens_dir" ] || tokens_dir="/etc/substrate/tokens"
	bearer="$(first_line "$tokens_dir/$safe_surface")"
fi
export SUBSTRATE_TOKEN="$bearer"

post_emit() {
(
	set +e
	export SUBSTRATE_HOOK_SHA="$sha"
	export SUBSTRATE_HOOK_SUBJECT="$subject"
	export SUBSTRATE_HOOK_SURFACE="$surface"
	export SUBSTRATE_HOOK_ACTOR="$actor"
	export SUBSTRATE_HOOK_FILES="$files"
	export SUBSTRATE_HOOK_REPO="$repo"
	export SUBSTRATE_HOOK_BRANCH="$branch"
	bun -e '
const rawTimeout = Number(process.env.SUBSTRATE_TIMEOUT_MS);
const timeoutMs = Number.isFinite(rawTimeout) && rawTimeout > 0 ? rawTimeout : 3000;
const base = (process.env.SUBSTRATE_URL || "http://127.0.0.1:7410").replace(/\/+$/, "");
const token = (process.env.SUBSTRATE_TOKEN || "").trim();
let files = [];
try { files = JSON.parse(process.env.SUBSTRATE_HOOK_FILES || "[]"); } catch { files = []; }
if (!Array.isArray(files)) files = [];
const event = {
  kind: "commit",
  summary: "commit " + (process.env.SUBSTRATE_HOOK_SHA || "") + " " + (process.env.SUBSTRATE_HOOK_SUBJECT || ""),
  surface: process.env.SUBSTRATE_HOOK_SURFACE || "cursor",
  actor: process.env.SUBSTRATE_HOOK_ACTOR || "human",
  payload: { sha: process.env.SUBSTRATE_HOOK_SHA || "", files: files },
};
if (process.env.SUBSTRATE_HOOK_REPO) event.repo = process.env.SUBSTRATE_HOOK_REPO;
if (process.env.SUBSTRATE_HOOK_BRANCH) event.branch = process.env.SUBSTRATE_HOOK_BRANCH;
function report(status, error) {
  const safe = String(error || "").replace(/[\r\n]/g, " ").slice(0, 200);
  const suffix = safe ? " error=" + safe : "";
  process.stderr.write("[substrate] post-commit emit refused: status=" + status + suffix + "\n");
}
try {
  const response = await fetch(base + "/events", {
    method: "POST",
    headers: {
      "content-type": "application/json",
      ...(token ? { authorization: "Bearer " + token } : {}),
    },
    body: JSON.stringify(event),
    signal: AbortSignal.timeout(timeoutMs),
  });
  if (!response.ok) {
    let error = "";
    try {
      const body = await response.json();
      if (body && typeof body.error === "string") error = body.error;
    } catch {}
    report(response.status, error);
  }
} catch {
  report(0, "unreachable");
}
'
)
}

# Where a headless refusal goes. A terminal still sees the line on /dev/tty.
# A commit with no controlling terminal — a background agent, a captured job —
# must not inherit the hook's pipes, and must not throw the line away either.
hook_log() {
	if [ -n "${SUBSTRATE_HOOK_LOG:-}" ]; then
		printf '%s\n' "$SUBSTRATE_HOOK_LOG"
		return
	fi
	if [ -n "${XDG_STATE_HOME:-}" ]; then
		printf '%s\n' "$XDG_STATE_HOME/substrate/post-commit.log"
		return
	fi
	if [ -n "${HOME:-}" ]; then
		printf '%s\n' "$HOME/.local/state/substrate/post-commit.log"
		return
	fi
	printf '%s\n' "/tmp/substrate-post-commit.log"
}

# SUBSTRATE_HOOK_WAIT=1 is the test: the line has to land on this process's
# stderr. Anything else must not inherit these pipes. A caller that captures
# `git commit` and waits for both of them to close would otherwise sit out the
# substrate timeout after the hook itself has exited.
if [ "${SUBSTRATE_HOOK_WAIT:-}" = "1" ]; then
	post_emit || true
elif ( : >/dev/tty ) 2>/dev/null; then
	post_emit </dev/null >/dev/tty 2>&1 &
	disown 2>/dev/null || true
else
	log="$(hook_log)"
	mkdir -p "$(dirname "$log")" 2>/dev/null || true
	# Open the log in the child. Redirecting `>>` in the parent skips post_emit
	# when the file itself is not writable, even if its directory is, and the
	# commit event is never sent. A failed open falls back to /dev/null.
	(
		exec >>"$log" 2>&1 || exec >/dev/null 2>&1
		post_emit
	) </dev/null >/dev/null 2>&1 &
	disown 2>/dev/null || true
fi

exit 0
